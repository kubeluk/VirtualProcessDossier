    prov:startedAtTime "2026-09-24T10:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-09-24T10:02:34Z"^^xsd:dateTime ;
    prov:wasAssociatedWith <http://purl.org/for/system/frame/1#it> ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent <http://purl.org/for/system/frame/1#it> ;
        prov:hadPlan [
            a prov:Plan ;
            frame:gripperPosition [
                frame:position [
                    a qudt:Quantity ;
                    qudt:hasQuantityKind quantitykind:PositionVector ;
