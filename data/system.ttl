@base <http://purl.org/for/> .

@prefix for: <http://purl.org/for/terms#> .
@prefix frame: <http://purl.org/for/system/frame#> .
@prefix pos: <http://purl.org/for/position#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

# Setup FoFa

## Systems

<system/demonstrator#it> a ssn:System ;
    rdfs:label "FoFa Demonstrator"@en ;
    rdfs:comment "The demonstrator as set up at the Forschungsfabrik"@en ;
    ssn:hasSubSystem <system/axis/1#it>, <system/frame/1#it>, <system/oven/1#it>, <system/press/1#it>, <system/inspector/1#it> .

## Linear Axis

<system/axis/1#it> a ssn:System ;
    rdfs:label "Linear Axis"@en ;
    rdfs:comment "The linear axis is used for moving the gripper frame."@en .

## Gripper Frame

<system/frame/1#it> a ssn:System ;
    rdfs:label "Gripper Frame"@en ;
    rdfs:comment "The gripper frame is a base structure that is comprised of a range of grippers which are used for fixing a sheet of laminate in place."@en ;
    frame:hasSize [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Length ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 800.0
    ] ;
    frame:hasSize [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Width ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 800.0
    ] ;
    pos:hasPositionalReference frame:referencePoint ;
    ssn:hasSubSystem <system/gripper/1#it>, <system/gripper/2#it>, <system/gripper/3#it>, <system/gripper/4#it>, <system/gripper/5#it>, <system/gripper/6#it>, <system/gripper/7#it>, <system/gripper/8#it> ;
    for:takesParameters <system/frame/1#parameters> .

<system/gripper/1#it> a ssn:System ;
    rdfs:label "Gripper 1" ;
    ssn:hasSubSystem <sensor/angle/1#it>, <sensor/force/1#it>, <sensor/extension/1#it> .

<system/gripper/2#it> a ssn:System ;
    rdfs:label "Gripper 2" ;
    ssn:hasSubSystem <sensor/angle/2#it>, <sensor/force/2#it>, <sensor/extension/2#it> .

<system/gripper/3#it> a ssn:System ;
    rdfs:label "Gripper 3" ;
    ssn:hasSubSystem <sensor/angle/3#it>, <sensor/force/3#it>, <sensor/extension/3#it> .

<system/gripper/4#it> a ssn:System ;
    rdfs:label "Gripper 4" ;
    ssn:hasSubSystem <sensor/angle/4#it>, <sensor/force/4#it>, <sensor/extension/4#it> .

<system/gripper/5#it> a ssn:System ;
    rdfs:label "Gripper 5" ;
    ssn:hasSubSystem <sensor/angle/5#it>, <sensor/force/5#it>, <sensor/extension/5#it> .

<system/gripper/6#it> a ssn:System ;
    rdfs:label "Gripper 6" ;
    ssn:hasSubSystem <sensor/angle/6#it>, <sensor/force/6#it>, <sensor/extension/6#it> .

<system/gripper/7#it> a ssn:System ;
    rdfs:label "Gripper 7" ;
    ssn:hasSubSystem <sensor/angle/7#it>, <sensor/force/7#it>, <sensor/extension/7#it> .

<system/gripper/8#it> a ssn:System ;
    rdfs:label "Gripper 8" ;
    ssn:hasSubSystem <sensor/angle/8#it>, <sensor/force/8#it>, <sensor/extension/8#it> .

### Angle

<sensor/angle/1#it> a sosa:Sensor .

<sensor/angle/2#it> a sosa:Sensor .

<sensor/angle/3#it> a sosa:Sensor .

<sensor/angle/4#it> a sosa:Sensor .

<sensor/angle/5#it> a sosa:Sensor .

<sensor/angle/6#it> a sosa:Sensor .

<sensor/angle/7#it> a sosa:Sensor .

<sensor/angle/8#it> a sosa:Sensor .

### Force

<sensor/force/1#it> a sosa:Sensor .

<sensor/force/2#it> a sosa:Sensor .

<sensor/force/3#it> a sosa:Sensor .

<sensor/force/4#it> a sosa:Sensor .

<sensor/force/5#it> a sosa:Sensor .

<sensor/force/6#it> a sosa:Sensor .

<sensor/force/7#it> a sosa:Sensor .

<sensor/force/8#it> a sosa:Sensor .

### Extension

<sensor/extension/1#it> a sosa:Sensor .

<sensor/extension/2#it> a sosa:Sensor .

<sensor/extension/3#it> a sosa:Sensor .

<sensor/extension/4#it> a sosa:Sensor .

<sensor/extension/5#it> a sosa:Sensor .

<sensor/extension/6#it> a sosa:Sensor .

<sensor/extension/7#it> a sosa:Sensor .

<sensor/extension/8#it> a sosa:Sensor .

### Reference

frame:referencePoint a for:ReferencePoint ;
    rdfs:label "Greiferrahmen Reference Point"@en ;
    rdfs:comment "Die linke, untere Ecke des Greiferrahmens bildet den Bezugspunkt für die Positionen der Greiferpunkte."@de .

## Oven

<system/oven/1#it> a ssn:System ;
    rdfs:label "Infrared (IR) Oven"@en ;
    rdfs:comment "Infrared (IR) oven comprised of two parts (top and bottom)."@en ;
    ssn:hasSubSystem <system/oven/1#top>, <system/oven/1#bottom> ;
    for:takesParameters <system/oven/1#parameters> .

<system/oven/1#top> a ssn:System ;
    rdfs:label "IR Field (top)"@en ;
    rdfs:comment "The top IR field consists of four individually controllable zones that each make up a corner."@en ;
    ssn:hasSubSystem <system/field/1#it>, <system/field/2#it>, <system/field/3#it>, <system/field/4#it> .

<system/oven/1#bottom> a ssn:System ;
    rdfs:label "IR Field (bottom)"@en ;
    rdfs:comment "The bottom IR field consists of four individually controllable zones that each make up a corner."@en ;
    ssn:hasSubSystem <system/field/5#it>, <system/field/6#it>, <system/field/7#it>, <system/field/8#it> ;
    ssn:hasSubSystem <sensor/pyrometer/1#it> .

<system/field/1#it> a ssn:System ;
    rdfs:label "Heizfeld 1"@de .

<system/field/2#it> a ssn:System ;
    rdfs:label "Heizfeld 2"@de .

<system/field/3#it> a ssn:System ;
    rdfs:label "Heizfeld 3"@de .

<system/field/4#it> a ssn:System ;
    rdfs:label "Heizfeld 4"@de .

<system/field/5#it> a ssn:System ;
    rdfs:label "Heizfeld 5"@de .

<system/field/6#it> a ssn:System ;
    rdfs:label "Heizfeld 6"@de .

<system/field/7#it> a ssn:System ;
    rdfs:label "Heizfeld 7"@de .

<system/field/8#it> a ssn:System ;
    rdfs:label "Heizfeld 8"@de .

### Pyrometer

<sensor/pyrometer/1#it> a sosa:Sensor ;
    rdfs:label "Pyrometer 1"@en ;
    rdfs:comment "The pyrometer is used for measuring the surface temperature of the laminate during heating."@en .

## Press

<system/press/1#it> a ssn:System ;
    rdfs:label "Press"@en ;
    rdfs:comment "The press is used for forming the laminate."@en ;
    ssn:hasSubSystem <system/press/1#upperMold>, <system/press/1#lowerMold> ;
    for:takesParameters <system/press/1#parameters> .

<system/press/1#upperMold> a ssn:System ;
    rdfs:label "Upper Mold"@en ;
    rdfs:comment "The upper mold is used for forming the laminate."@en .

<system/press/1#lowerMold> a ssn:System ;
    rdfs:label "Lower Mold"@en ;
    rdfs:comment "The lower mold is used for forming the laminate."@en .

## Inspection

<system/inspector/1#it> a ssn:System ;
    rdfs:label "Inspector"@en ;
    rdfs:comment "The inspector is used for inspecting the laminate after forming."@en ;
    ssn:hasSubSystem <sensor/camera/1#it> .

<sensor/camera/1#it> a sosa:Sensor ;
    rdfs:label "Camera"@en ;
    rdfs:comment "The camera is used for taking images of the laminate after forming."@en .
