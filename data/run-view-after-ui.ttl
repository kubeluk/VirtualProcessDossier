@base <http://purl.org/for/> .

@prefix for: <http://purl.org/for/terms#> .
@prefix press: <http://purl.org/system/press/1#> .
@prefix oven: <http://purl.org/system/oven/1#> .
@prefix frame: <http://purl.org/system/frame/1#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix workflow: <http://purl.org/for/workflow#> .
@prefix activity: <http://purl.org/for/activity#> .
@prefix pos: <http://purl.org/for/position#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix wild: <http://purl.org/wild/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Workflow Run

## Workflow instance

<workflow/instance/1#it> a wild:WorkflowInstance ;
    rdfs:label "Trial No. 1" ;
    rdfs:comment "Inbetriebnahme Heizfeld und Greiferrahmen" ;
    wild:workflowInstanceOf workflow:stampForming ;
    wild:hasState wild:initialized ;
    for:workflowInitialization [
        for:laminate <laminate/1#it> ;
        for:parameterization [
            a prov:Collection ;
            prov:hadMember <plan/1#gripping> ;
            prov:hadMember <plan/1#heating> ;
            prov:hadMember <plan/1#pressing>
        ]
    ] .

## Behaviour

<workflow/instance/1#stampFormingFlow> a wild:ActivityInstance ;
    wild:inWorkflowInstance <workflow/instance/1#it> ;
    wild:activityInstanceOf activity:stampFormingFlow ;
    wild:hasState wild:initialized .

