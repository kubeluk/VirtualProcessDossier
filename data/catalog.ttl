@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype:  <http://purl.org/dc/dcmitype/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix vpd:     <https://example.org/vpd#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix ssn:     <http://www.w3.org/ns/ssn/> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix wild:    <http://purl.org/wild/vocab#> .

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

vpd:catalog
    a dcat:Catalog ;
    dcterms:title        "VPD Data Catalog"@en ;
    dcterms:description  "A catalog of datasets managed within the VPD knowledge graph."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2026-04-09"^^xsd:date ;
    dcterms:modified     "2026-04-09"^^xsd:date ;
    dcterms:language     <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcat:dataset
        vpd:dataset-machine-temperature ,
        vpd:dataset-hydraulic-pressure ,
        vpd:dataset-power-consumption ,
        vpd:dataset-machine-vibration ;
    dcat:service
        vpd:service-machine-monitoring-api .

# ---------------------------------------------------------------------------
# Publisher
# ---------------------------------------------------------------------------

vpd:org-kit
    a foaf:Organization ;
    foaf:name "Karlsruhe Institute of Technology"@en .

# ---------------------------------------------------------------------------
# Datasets
# ---------------------------------------------------------------------------

vpd:dataset-machine-temperature
    a dcat:Dataset ;
    dcterms:title        "CNC Machine Temperature Monitoring"@en ;
    dcterms:description  "High-frequency spindle, coolant, and ambient temperature readings from CNC machining centres on production line A, collected during active cutting operations to detect thermal drift and prevent dimensional inaccuracy."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2024-03-01"^^xsd:date ;
    dcterms:modified     "2026-04-08"^^xsd:date ;
    dcterms:temporal     vpd:period-2024-onwards ;
    dcterms:spatial      vpd:location-plant-hall-a ;
    dcat:keyword         "temperature" , "CNC" , "machining" , "thermal monitoring" , "manufacturing" ;
    dcat:landingPage     <https://example.org/vpd/pages/machine-temperature> ;
    dcat:distribution    vpd:dist-machine-temp-csv , vpd:dist-machine-temp-json ;
    prov:wasGeneratedBy  vpd:obs-machine-temperature ;
    dcterms:isPartOf     vpd:obs-machine-temperature .

vpd:dataset-hydraulic-pressure
    a dcat:Dataset ;
    dcterms:title        "Hydraulic Press Pressure Readings"@en ;
    dcterms:description  "Continuous pressure readings (bar) from hydraulic circuits of stamping and forming presses on production line B, recorded throughout each press cycle to verify forming force and detect circuit faults."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2023-09-01"^^xsd:date ;
    dcterms:modified     "2026-04-01"^^xsd:date ;
    dcterms:temporal     vpd:period-2023-onwards ;
    dcterms:spatial      vpd:location-plant-hall-b ;
    dcat:keyword         "pressure" , "hydraulics" , "press" , "stamping" , "manufacturing" ;
    dcat:landingPage     <https://example.org/vpd/pages/hydraulic-pressure> ;
    dcat:distribution    vpd:dist-hydraulic-pressure-csv ;
    prov:wasGeneratedBy  vpd:obs-hydraulic-pressure ;
    dcterms:isPartOf     vpd:obs-hydraulic-pressure .

vpd:dataset-power-consumption
    a dcat:Dataset ;
    dcterms:title        "Production Line Power Consumption"@en ;
    dcterms:description  "Active power (kW), reactive power (kVAr) and energy consumption (kWh) sampled at 1-minute intervals across all production cells, spanning the full workflow from line startup through dispatch to support energy management and operational efficiency analysis."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2023-01-01"^^xsd:date ;
    dcterms:modified     "2026-04-09"^^xsd:date ;
    dcterms:temporal     vpd:period-2023-onwards ;
    dcterms:spatial      vpd:location-plant-floor ;
    dcat:keyword         "power" , "energy" , "electricity" , "production" , "manufacturing" ;
    dcat:landingPage     <https://example.org/vpd/pages/power-consumption> ;
    dcat:distribution    vpd:dist-power-csv , vpd:dist-power-parquet ;
    prov:wasGeneratedBy  vpd:obs-power-consumption ;
    dcterms:isPartOf     vpd:wfinst-manufacturing-line .

vpd:dataset-machine-vibration
    a dcat:Dataset ;
    dcterms:title        "Spindle Vibration and Condition Monitoring"@en ;
    dcterms:description  "Tri-axial vibration acceleration (m/s²) and RMS envelope data from spindle bearings, captured during CNC machining operations to detect early-stage bearing wear and schedule predictive maintenance before failures occur."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2024-06-01"^^xsd:date ;
    dcterms:modified     "2026-03-15"^^xsd:date ;
    dcterms:temporal     vpd:period-2024-onwards ;
    dcterms:spatial      vpd:location-plant-hall-a ;
    dcat:keyword         "vibration" , "condition monitoring" , "predictive maintenance" , "bearings" , "manufacturing" ;
    dcat:landingPage     <https://example.org/vpd/pages/machine-vibration> ;
    dcat:distribution    vpd:dist-vibration-csv , vpd:dist-vibration-hdf5 ;
    prov:wasGeneratedBy  vpd:obs-machine-vibration ;
    dcterms:isPartOf     vpd:obs-machine-vibration .

