# Catalog

vpd:it a dcat:Catalog ;
    dcterms:title "Virtual Process Dossier (VPD)" ;
    dcterms:description "A FAIR, process-aware data catalog" ;
    dcat:dataset dataset:1, dataset:2, dataset:3, dataset:4 .

## Datasets

### Activity Observations

dataset:1 a dcat:Dataset ;
    dcterms:title "Sensordaten 1" ;
    dcterms:description "Sensordaten von der Inbetriebnahme des Heizfelds und Greiferrahmens am 30.03.2026" ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:downloadURL <https://os-webdav.lsdf.kit.edu/kit/iar/projects/FOR_5339/T1/Versuchsdaten/Versuchskampagne%202026_1/Pressendaten/%231.1_BASF_Test_1_20260330_101925.txt> ;
        dcat:mediaType "text/tab-separated-values" ;
        dcat:temporalResolution "PT0.02S"^^xsd:duration ;
    ] ;
    prov:wasGeneratedBy <workflow/instance/1#observeGripperForce1> .

### Part 3D Scans

dataset:2 a dcat:Dataset ;
    dcterms:title "Scan-Daten 12" ;
    dcterms:description "3D-Scan des gefertigten Bauteils von Versuch No. 12" ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:mediaType "model/stl" ;
        dcat:downloadURL <https://os-webdav.lsdf.kit.edu/kit/iar/projects/FOR_5339/T1/Versuchsdaten/Versuchskampagne%202026_1/3D-Scans/2.1.stl> ;
    ] ;
    prov:wasGeneratedBy <workflow/instance/1#observeLaminateShape1> .

dataset:3 a dcat:Dataset ;
    dcterms:title "Example laminate surface temperature" ;
    dcterms:description "Synthetic temperature data demonstrating a dataset connected to a laminate observation and production run." ;
    prov:wasGeneratedBy <workflow/instance/1#observeLaminateSurfaceTemperature1> ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:downloadURL <http://localhost:8080/example-data/temperature.tsv> ;
        dcat:mediaType "text/tab-separated-values" ;
        dcat:temporalResolution "PT1S"^^xsd:duration
    ] .

dataset:4 a dcat:Dataset ;
    dcterms:title "Example gripper 2 force" ;
    dcterms:description "Synthetic force data. Its feature of interest is a gripper, not the run's input laminate." ;
    prov:wasGeneratedBy <workflow/instance/1#observeGripperForce2> ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:downloadURL <http://localhost:8080/example-data/force.tsv> ;
        dcat:mediaType "text/tab-separated-values" ;
        dcat:temporalResolution "PT1S"^^xsd:duration
    ] .