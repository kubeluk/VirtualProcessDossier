@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype:  <http://purl.org/dc/dcmitype/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix vpd:     <https://example.org/vpd#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix ssn:     <http://www.w3.org/ns/ssn/> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

vpd:catalog
    a dcat:Catalog ;
    dcterms:title        "VPD Data Catalog"@en ;
    dcterms:description  "A catalog of datasets managed within the VPD knowledge graph."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2026-04-09"^^xsd:date ;
    dcterms:modified     "2026-04-09"^^xsd:date ;
    dcterms:language     <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcat:dataset
        vpd:dataset-air-quality ,
        vpd:dataset-traffic-flow ,
        vpd:dataset-weather-stations ,
        vpd:dataset-land-use-map ;
    dcat:service
        vpd:service-sensor-api .

# ---------------------------------------------------------------------------
# Publisher
# ---------------------------------------------------------------------------

vpd:org-kit
    a foaf:Organization ;
    foaf:name "Karlsruhe Institute of Technology"@en .

# ---------------------------------------------------------------------------
# Datasets
# ---------------------------------------------------------------------------

vpd:dataset-air-quality
    a dcat:Dataset ;
    dcterms:title        "Air Quality Measurements"@en ;
    dcterms:description  "Hourly PM2.5, PM10, NO2 and O3 measurements from sensor stations across the city."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2024-01-15"^^xsd:date ;
    dcterms:modified     "2026-03-01"^^xsd:date ;
    dcterms:temporal     vpd:period-2024-onwards ;
    dcterms:spatial      vpd:location-karlsruhe ;
    dcat:keyword         "air quality" , "PM2.5" , "pollution" , "sensors" ;
    dcat:theme           <http://eurovoc.europa.eu/2527> ;
    dcat:landingPage     <https://example.org/vpd/pages/air-quality> ;
    dcat:distribution    vpd:dist-air-quality-csv , vpd:dist-air-quality-json ;
    prov:wasGeneratedBy  vpd:obs-air-quality .

vpd:dataset-traffic-flow
    a dcat:Dataset ;
    dcterms:title        "Traffic Flow Counts"@en ;
    dcterms:description  "Daily vehicle counts at road sensor loops, broken down by vehicle class."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2023-06-01"^^xsd:date ;
    dcterms:modified     "2026-04-01"^^xsd:date ;
    dcterms:temporal     vpd:period-2023-onwards ;
    dcterms:spatial      vpd:location-karlsruhe ;
    dcat:keyword         "traffic" , "mobility" , "road sensors" ;
    dcat:theme           <http://eurovoc.europa.eu/4512> ;
    dcat:landingPage     <https://example.org/vpd/pages/traffic-flow> ;
    dcat:distribution    vpd:dist-traffic-flow-csv ;
    prov:wasGeneratedBy  vpd:obs-traffic-flow .

vpd:dataset-weather-stations
    a dcat:Dataset ;
    dcterms:title        "Weather Station Observations"@en ;
    dcterms:description  "Temperature, humidity, precipitation and wind speed readings from weather stations."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2022-09-01"^^xsd:date ;
    dcterms:modified     "2026-04-08"^^xsd:date ;
    dcterms:temporal     vpd:period-2022-onwards ;
    dcterms:spatial      vpd:location-karlsruhe-region ;
    dcat:keyword         "weather" , "temperature" , "humidity" , "climate" ;
    dcat:theme           <http://eurovoc.europa.eu/3355> ;
    dcat:landingPage     <https://example.org/vpd/pages/weather-stations> ;
    dcat:distribution    vpd:dist-weather-csv , vpd:dist-weather-netcdf ;
    prov:wasGeneratedBy  vpd:obs-weather-stations .

vpd:dataset-land-use-map
    a dcat:Dataset ;
    dcterms:title        "Land Use Classification Map"@en ;
    dcterms:description  "Geospatial raster dataset classifying land cover categories (urban, forest, agriculture, water)."@en ;
    dcterms:publisher    vpd:org-kit ;
    dcterms:issued       "2023-01-01"^^xsd:date ;
    dcterms:modified     "2025-11-20"^^xsd:date ;
    dcterms:spatial      vpd:location-karlsruhe-region ;
    dcat:keyword         "land use" , "GIS" , "remote sensing" , "geospatial" ;
    dcat:theme           <http://eurovoc.europa.eu/2825> ;
    dcat:landingPage     <https://example.org/vpd/pages/land-use> ;
    dcat:distribution    vpd:dist-land-use-geotiff ;
    prov:wasGeneratedBy  vpd:obs-land-use .

# ---------------------------------------------------------------------------
# Distributions
# ---------------------------------------------------------------------------

vpd:dist-air-quality-csv
    a dcat:Distribution ;
    dcterms:title     "Air Quality — CSV"@en ;
    dcat:mediaType    <https://www.iana.org/assignments/media-types/text/csv> ;
    dcat:downloadURL  <https://example.org/vpd/files/air-quality.csv> ;
    dcat:byteSize     "52428800"^^xsd:nonNegativeInteger .

vpd:dist-air-quality-json
    a dcat:Distribution ;
    dcterms:title     "Air Quality — JSON"@en ;
    dcat:mediaType    <https://www.iana.org/assignments/media-types/application/json> ;
    dcat:downloadURL  <https://example.org/vpd/files/air-quality.json> ;
    dcat:byteSize     "78643200"^^xsd:nonNegativeInteger .

vpd:dist-traffic-flow-csv
    a dcat:Distribution ;
    dcterms:title     "Traffic Flow — CSV"@en ;
    dcat:mediaType    <https://www.iana.org/assignments/media-types/text/csv> ;
    dcat:downloadURL  <https://example.org/vpd/files/traffic-flow.csv> ;
    dcat:byteSize     "10485760"^^xsd:nonNegativeInteger .

vpd:dist-weather-csv
    a dcat:Distribution ;
    dcterms:title     "Weather Observations — CSV"@en ;
    dcat:mediaType    <https://www.iana.org/assignments/media-types/text/csv> ;
    dcat:downloadURL  <https://example.org/vpd/files/weather-stations.csv> ;
    dcat:byteSize     "26214400"^^xsd:nonNegativeInteger .

vpd:dist-weather-netcdf
    a dcat:Distribution ;
    dcterms:title     "Weather Observations — NetCDF"@en ;
    dcat:mediaType    <https://www.iana.org/assignments/media-types/application/x-netcdf> ;
    dcat:downloadURL  <https://example.org/vpd/files/weather-stations.nc> ;
    dcat:byteSize     "15728640"^^xsd:nonNegativeInteger .

vpd:dist-land-use-geotiff
    a dcat:Distribution ;
    dcterms:title     "Land Use Map — GeoTIFF"@en ;
    dcat:mediaType    <https://www.iana.org/assignments/media-types/image/tiff> ;
    dcat:downloadURL  <https://example.org/vpd/files/land-use.tif> ;
    dcat:byteSize     "209715200"^^xsd:nonNegativeInteger .

# ---------------------------------------------------------------------------
# Data Service
# ---------------------------------------------------------------------------

vpd:service-sensor-api
    a dcat:DataService ;
    dcterms:title        "VPD Sensor REST API"@en ;
    dcterms:description  "REST API providing real-time and historical sensor readings for air quality and weather stations."@en ;
    dcat:endpointURL     <https://example.org/vpd/api/v1/sensors> ;
    dcat:endpointDescription <https://example.org/vpd/api/v1/openapi.json> ;
    dcat:servesDataset   vpd:dataset-air-quality , vpd:dataset-weather-stations .

# ---------------------------------------------------------------------------
# Supporting resources
# ---------------------------------------------------------------------------

vpd:period-2024-onwards
    a dcterms:PeriodOfTime ;
    dcat:startDate "2024-01-01"^^xsd:date .

vpd:period-2023-onwards
    a dcterms:PeriodOfTime ;
    dcat:startDate "2023-01-01"^^xsd:date .

vpd:period-2022-onwards
    a dcterms:PeriodOfTime ;
    dcat:startDate "2022-01-01"^^xsd:date .

vpd:location-karlsruhe
    a dcterms:Location ;
    foaf:name "Karlsruhe, Germany" .

vpd:location-karlsruhe-region
    a dcterms:Location ;
    foaf:name "Karlsruhe Region, Germany" .

# ---------------------------------------------------------------------------
# Observable Properties (one per dataset)
# ---------------------------------------------------------------------------

vpd:prop-air-quality-params
    a sosa:ObservableProperty ;
    dcterms:title "Air Quality Parameters"@en ;
    dcterms:description "Multicomponent air quality measurement: PM2.5, PM10, NO2 and O3 concentrations in µg/m³."@en .

vpd:prop-vehicle-count
    a sosa:ObservableProperty ;
    dcterms:title "Daily Vehicle Count"@en ;
    dcterms:description "Number of vehicles crossing a road cross-section per day, disaggregated by vehicle class."@en .

vpd:prop-meteorological-params
    a sosa:ObservableProperty ;
    dcterms:title "Meteorological Parameters"@en ;
    dcterms:description "Standard atmospheric measurements: air temperature (°C), relative humidity (%), precipitation (mm) and wind speed (m/s)."@en .

vpd:prop-land-cover-class
    a sosa:ObservableProperty ;
    dcterms:title "Land Cover Classification"@en ;
    dcterms:description "Discrete land cover class assigned per pixel (urban, forest, agriculture, water), derived from multispectral satellite imagery."@en .

# ---------------------------------------------------------------------------
# Features of Interest (one per dataset)
# ---------------------------------------------------------------------------

vpd:foi-air-karlsruhe
    a sosa:FeatureOfInterest ;
    dcterms:title "Ambient Air — Karlsruhe"@en ;
    dcterms:description "Ambient air across the Karlsruhe urban area, characterised by its particulate and gaseous pollutant load."@en ;
    ssn:hasProperty vpd:prop-air-quality-params .

vpd:foi-road-network-karlsruhe
    a sosa:FeatureOfInterest ;
    dcterms:title "Road Network — Karlsruhe"@en ;
    dcterms:description "The motorised road network within Karlsruhe city limits, characterised by vehicular traffic flow."@en ;
    ssn:hasProperty vpd:prop-vehicle-count .

vpd:foi-atmosphere-karlsruhe-region
    a sosa:FeatureOfInterest ;
    dcterms:title "Lower Atmosphere — Karlsruhe Region"@en ;
    dcterms:description "The atmospheric boundary layer above the Karlsruhe administrative region."@en ;
    ssn:hasProperty vpd:prop-meteorological-params .

vpd:foi-land-surface-karlsruhe-region
    a sosa:FeatureOfInterest ;
    dcterms:title "Land Surface — Karlsruhe Region"@en ;
    dcterms:description "Land surface of the Karlsruhe administrative region as observed by satellite remote sensing."@en ;
    ssn:hasProperty vpd:prop-land-cover-class .

# ---------------------------------------------------------------------------
# Sensors (one per dataset)
# ---------------------------------------------------------------------------

vpd:sensor-aq-network
    a sosa:Sensor ;
    dcterms:title "Karlsruhe Air Quality Sensor Network"@en ;
    dcterms:description "Network of optical particle counters and electrochemical gas sensors deployed across Karlsruhe, operated by KIT."@en ;
    sosa:observes vpd:prop-air-quality-params .

vpd:sensor-traffic-loop-network
    a sosa:Sensor ;
    dcterms:title "Karlsruhe Traffic Inductive Loop Network"@en ;
    dcterms:description "Embedded inductive loop detectors at key road cross-sections in Karlsruhe, measuring daily vehicle counts and speed profiles."@en ;
    sosa:observes vpd:prop-vehicle-count .

vpd:sensor-weather-network
    a sosa:Sensor ;
    dcterms:title "Karlsruhe Weather Station Network"@en ;
    dcterms:description "Automatic weather stations operated jointly by KIT (Campus South, WMO 10731) and DWD (Rheinstetten, station 4177)."@en ;
    sosa:observes vpd:prop-meteorological-params .

vpd:sensor-sentinel2-2a
    a sosa:Sensor ;
    dcterms:title "Sentinel-2A Multispectral Instrument (MSI)"@en ;
    dcterms:description "ESA Copernicus Sentinel-2A satellite carrying the 13-band multispectral instrument at 10–60 m spatial resolution."@en ;
    sosa:observes vpd:prop-land-cover-class .

# ---------------------------------------------------------------------------
# Observations — one per dataset, typed as both sosa:Observation and
# prov:Activity. Each dataset is the result of its observation:
#   dataset  prov:wasGeneratedBy  observation
#   observation  sosa:hasResult   dataset
# ---------------------------------------------------------------------------

vpd:obs-air-quality
    a sosa:Observation , prov:Activity ;
    dcterms:title "Air Quality Monitoring — Karlsruhe"@en ;
    sosa:madeBySensor         vpd:sensor-aq-network ;
    sosa:hasFeatureOfInterest vpd:foi-air-karlsruhe ;
    sosa:observedProperty     vpd:prop-air-quality-params ;
    sosa:hasResult            vpd:dataset-air-quality ;
    sosa:resultTime           "2026-03-01T23:00:00Z"^^xsd:dateTime ;
    prov:startedAtTime        "2024-01-15T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-03-01T23:00:00Z"^^xsd:dateTime .

vpd:obs-traffic-flow
    a sosa:Observation , prov:Activity ;
    dcterms:title "Traffic Flow Monitoring — Karlsruhe"@en ;
    sosa:madeBySensor         vpd:sensor-traffic-loop-network ;
    sosa:hasFeatureOfInterest vpd:foi-road-network-karlsruhe ;
    sosa:observedProperty     vpd:prop-vehicle-count ;
    sosa:hasResult            vpd:dataset-traffic-flow ;
    sosa:resultTime           "2026-04-01T23:59:59Z"^^xsd:dateTime ;
    prov:startedAtTime        "2023-06-01T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-04-01T23:59:59Z"^^xsd:dateTime .

vpd:obs-weather-stations
    a sosa:Observation , prov:Activity ;
    dcterms:title "Meteorological Observations — Karlsruhe Region"@en ;
    sosa:madeBySensor         vpd:sensor-weather-network ;
    sosa:hasFeatureOfInterest vpd:foi-atmosphere-karlsruhe-region ;
    sosa:observedProperty     vpd:prop-meteorological-params ;
    sosa:hasResult            vpd:dataset-weather-stations ;
    sosa:resultTime           "2026-04-08T23:00:00Z"^^xsd:dateTime ;
    prov:startedAtTime        "2022-09-01T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-04-08T23:00:00Z"^^xsd:dateTime .

vpd:obs-land-use
    a sosa:Observation , prov:Activity ;
    dcterms:title "Land Cover Classification — Karlsruhe Region (Sentinel-2)"@en ;
    sosa:madeBySensor         vpd:sensor-sentinel2-2a ;
    sosa:hasFeatureOfInterest vpd:foi-land-surface-karlsruhe-region ;
    sosa:observedProperty     vpd:prop-land-cover-class ;
    sosa:hasResult            vpd:dataset-land-use-map ;
    sosa:resultTime           "2025-11-20T00:00:00Z"^^xsd:dateTime ;
    prov:startedAtTime        "2023-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2025-11-20T00:00:00Z"^^xsd:dateTime .
