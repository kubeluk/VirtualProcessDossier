# ---------------------------------------------------------------------------
# Data Service
# ---------------------------------------------------------------------------

vpd:service-machine-monitoring-api
    a dcat:DataService ;
    dcterms:title        "VPD Machine Monitoring REST API"@en ;
    dcterms:description  "REST API providing real-time and historical sensor readings for machine temperature, pressure, power, and vibration."@en ;
    dcat:endpointURL     <https://example.org/vpd/api/v1/machines> ;
    dcat:endpointDescription <https://example.org/vpd/api/v1/openapi.json> ;
    dcat:servesDataset   vpd:dataset-machine-temperature , vpd:dataset-hydraulic-pressure ,
                         vpd:dataset-power-consumption , vpd:dataset-machine-vibration .

# ---------------------------------------------------------------------------
# Supporting resources
# ---------------------------------------------------------------------------

vpd:period-2024-onwards
    a dcterms:PeriodOfTime ;
    dcat:startDate "2024-01-01"^^xsd:date .

vpd:period-2023-onwards
    a dcterms:PeriodOfTime ;
    dcat:startDate "2023-01-01"^^xsd:date .

vpd:location-plant-hall-a
    a dcterms:Location ;
    foaf:name "Manufacturing Plant — Hall A (CNC & Machining)"@en .

vpd:location-plant-hall-b
    a dcterms:Location ;
    foaf:name "Manufacturing Plant — Hall B (Pressing & Forming)"@en .

vpd:location-plant-floor
    a dcterms:Location ;
    foaf:name "Manufacturing Plant — Production Floor"@en .

# ---------------------------------------------------------------------------
# Observable Properties (one per dataset)
# ---------------------------------------------------------------------------

vpd:prop-machine-temperature
    a sosa:ObservableProperty ;
    dcterms:title "Machine Temperature"@en ;
    dcterms:description "Multi-point temperature measurements on CNC machines: spindle motor (°C), coolant circuit (°C), and ambient enclosure temperature (°C)."@en .

vpd:prop-hydraulic-pressure
    a sosa:ObservableProperty ;
    dcterms:title "Hydraulic Circuit Pressure"@en ;
    dcterms:description "Gauge pressure (bar) at inlet and outlet ports of hydraulic circuits powering stamping and forming presses."@en .

vpd:prop-active-power
    a sosa:ObservableProperty ;
    dcterms:title "Electrical Power Draw"@en ;
    dcterms:description "Active power (kW), reactive power (kVAr) and cumulative energy (kWh) consumed by individual production cells and the overall line."@en .

vpd:prop-spindle-vibration
    a sosa:ObservableProperty ;
    dcterms:title "Spindle Bearing Vibration"@en ;
    dcterms:description "Tri-axial vibration acceleration (m/s²) and RMS envelope values measured at spindle bearing housings for condition monitoring."@en .

# ---------------------------------------------------------------------------
# Features of Interest (one per dataset)
# ---------------------------------------------------------------------------

vpd:foi-cnc-machines-hall-a
    a sosa:FeatureOfInterest ;
    dcterms:title "CNC Machining Centres — Hall A"@en ;
    dcterms:description "Fleet of 12 CNC machining centres in Hall A, characterised by their thermal state during cutting operations."@en ;
    ssn:hasProperty vpd:prop-machine-temperature .

vpd:foi-hydraulic-presses-hall-b
    a sosa:FeatureOfInterest ;
    dcterms:title "Hydraulic Presses — Hall B"@en ;
    dcterms:description "Six hydraulic stamping and forming presses in Hall B, characterised by the pressure state of their hydraulic circuits."@en ;
    ssn:hasProperty vpd:prop-hydraulic-pressure .

vpd:foi-production-line
    a sosa:FeatureOfInterest ;
    dcterms:title "Production Line — Full Floor"@en ;
    dcterms:description "Complete production floor comprising all machining, pressing, assembly, and auxiliary cells, characterised by electrical power demand."@en ;
    ssn:hasProperty vpd:prop-active-power .

vpd:foi-spindle-bearings
    a sosa:FeatureOfInterest ;
    dcterms:title "CNC Spindle Bearings — Hall A"@en ;
    dcterms:description "Spindle bearing assemblies of CNC machining centres in Hall A, characterised by vibration signatures relevant to wear and fault detection."@en ;
    ssn:hasProperty vpd:prop-spindle-vibration .

# ---------------------------------------------------------------------------
# Sensors (one per dataset)
# ---------------------------------------------------------------------------

vpd:sensor-thermocouple-network
    a sosa:Sensor ;
    dcterms:title "CNC Thermocouple Network"@en ;
    dcterms:description "Type-K thermocouples and NTC thermistors embedded in spindle motors, coolant circuits, and enclosures of all CNC machines in Hall A."@en ;
    sosa:observes vpd:prop-machine-temperature .

vpd:sensor-pressure-transducers
    a sosa:Sensor ;
    dcterms:title "Hydraulic Pressure Transducers"@en ;
    dcterms:description "Piezoelectric pressure transducers installed at inlet and outlet ports of each hydraulic circuit across the presses in Hall B."@en ;
    sosa:observes vpd:prop-hydraulic-pressure .

vpd:sensor-power-meters
    a sosa:Sensor ;
    dcterms:title "Production Line Power Meters"@en ;
    dcterms:description "Three-phase digital power meters (class 0.5S) installed at each production cell's distribution board and at the main plant incomer."@en ;
    sosa:observes vpd:prop-active-power .

vpd:sensor-accelerometers
    a sosa:Sensor ;
    dcterms:title "Spindle Bearing Accelerometers"@en ;
    dcterms:description "MEMS tri-axial accelerometers mounted on spindle bearing housings, sampling at 25.6 kHz for vibration signature analysis."@en ;
    sosa:observes vpd:prop-spindle-vibration .

# ---------------------------------------------------------------------------
# Observations — each is a sosa:Observation, a prov:Activity, and a
# wild:ActivityInstance (wild:hasState wild:done ≡ prov:Activity).
#   dataset  prov:wasGeneratedBy  observation
#   observation  sosa:hasResult   dataset
#   observation  wild:activityInstanceOf  <workflow model activity>
#   observation  wild:inWorkflowInstance  vpd:wfinst-manufacturing-line
# ---------------------------------------------------------------------------

vpd:obs-machine-temperature
    a sosa:Observation , prov:Activity , wild:ActivityInstance ;
    dcterms:title             "CNC Machine Temperature Monitoring — Hall A"@en ;
    sosa:madeBySensor         vpd:sensor-thermocouple-network ;
    sosa:hasFeatureOfInterest vpd:foi-cnc-machines-hall-a ;
    sosa:observedProperty     vpd:prop-machine-temperature ;
    sosa:hasResult            vpd:dataset-machine-temperature ;
    sosa:resultTime           "2026-04-08T22:00:00Z"^^xsd:dateTime ;
    prov:startedAtTime        "2024-03-01T06:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-04-08T22:00:00Z"^^xsd:dateTime ;
    wild:activityInstanceOf   vpd:wfact-cnc-temperature ;
    wild:inWorkflowInstance   vpd:wfinst-manufacturing-line ;
    wild:hasState             wild:done .

vpd:obs-hydraulic-pressure
    a sosa:Observation , prov:Activity , wild:ActivityInstance ;
    dcterms:title             "Hydraulic Press Pressure Monitoring — Hall B"@en ;
    sosa:madeBySensor         vpd:sensor-pressure-transducers ;
    sosa:hasFeatureOfInterest vpd:foi-hydraulic-presses-hall-b ;
    sosa:observedProperty     vpd:prop-hydraulic-pressure ;
    sosa:hasResult            vpd:dataset-hydraulic-pressure ;
    sosa:resultTime           "2026-04-01T21:59:59Z"^^xsd:dateTime ;
    prov:startedAtTime        "2023-09-01T06:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-04-01T21:59:59Z"^^xsd:dateTime ;
    wild:activityInstanceOf   vpd:step-hydraulic-forming ;
    wild:inWorkflowInstance   vpd:wfinst-manufacturing-line ;
    wild:hasState             wild:done .

vpd:obs-power-consumption
    a sosa:Observation , prov:Activity , wild:ActivityInstance ;
    dcterms:title             "Production Line Power Consumption Monitoring"@en ;
    sosa:madeBySensor         vpd:sensor-power-meters ;
    sosa:hasFeatureOfInterest vpd:foi-production-line ;
    sosa:observedProperty     vpd:prop-active-power ;
    sosa:hasResult            vpd:dataset-power-consumption ;
    sosa:resultTime           "2026-04-09T06:00:00Z"^^xsd:dateTime ;
    prov:startedAtTime        "2023-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-04-09T06:00:00Z"^^xsd:dateTime ;
    wild:activityInstanceOf   vpd:step-material-preparation ;
    wild:inWorkflowInstance   vpd:wfinst-manufacturing-line ;
    wild:hasState             wild:done .

vpd:obs-machine-vibration
    a sosa:Observation , prov:Activity , wild:ActivityInstance ;
    dcterms:title             "Spindle Vibration Condition Monitoring — Hall A"@en ;
    sosa:madeBySensor         vpd:sensor-accelerometers ;
    sosa:hasFeatureOfInterest vpd:foi-spindle-bearings ;
    sosa:observedProperty     vpd:prop-spindle-vibration ;
    sosa:hasResult            vpd:dataset-machine-vibration ;
    sosa:resultTime           "2026-03-15T18:00:00Z"^^xsd:dateTime ;
    prov:startedAtTime        "2024-06-01T06:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime          "2026-03-15T18:00:00Z"^^xsd:dateTime ;
    wild:activityInstanceOf   vpd:wfact-cnc-vibration ;
    wild:inWorkflowInstance   vpd:wfinst-manufacturing-line ;
    wild:hasState             wild:done .

# ---------------------------------------------------------------------------
# Manufacturing Workflow Model (WiLD)
#
# Static structure — describes what activities are expected and in what order.
# The model uses a tree-shaped representation as required by WiLD:
#
#   vpd:wfact-root  (wild:SequentialActivity)
#   ├── vpd:step-material-preparation  (wild:AtomicActivity)
#   ├── vpd:step-cnc-machining         (wild:ParallelActivity)
#   │   ├── vpd:wfact-cnc-temperature  (wild:AtomicActivity)
#   │   └── vpd:wfact-cnc-vibration    (wild:AtomicActivity)
#   ├── vpd:step-hydraulic-forming     (wild:AtomicActivity)
#   └── vpd:step-quality-dispatch      (wild:AtomicActivity)
#
# Step sequencing is encoded by list order in wild:hasChildActivities.
# ---------------------------------------------------------------------------

vpd:workflow-manufacturing-line
    a wild:WorkflowModel ;
    dcterms:title       "Manufacturing Line Process"@en ;
    dcterms:description "Four-step production workflow covering raw material intake through quality inspection and dispatch. Sensor observations performed within each step are linked to this model as activity instances to provide full process context for the collected datasets."@en ;
    dcterms:issued      "2023-01-01"^^xsd:date ;
    wild:hasBehaviour   vpd:wfact-root .

# Root sequential activity — the four steps execute one after another.
vpd:wfact-root
    a wild:SequentialActivity ;
    dcterms:title            "Manufacturing Line — Sequential Root"@en ;
    wild:hasChildActivities  (
        vpd:step-material-preparation
        vpd:step-cnc-machining
        vpd:step-hydraulic-forming
        vpd:step-quality-dispatch
    ) .

# Step 1 — atomic: the single monitoring activity during this step is
# the power consumption observation.
vpd:step-material-preparation
    a wild:AtomicActivity ;
    dcterms:title       "Step 1: Raw Material Intake & Preparation"@en ;
    dcterms:description "Incoming raw stock is received, inspected against material certificates, and cut to near-net-shape blanks. Transfer pallets are loaded and the production line is brought online. Power consumption monitoring begins at this point to establish the energy baseline for the full shift."@en .

# Step 2 — parallel: temperature monitoring and vibration monitoring
# run concurrently on the CNC machines throughout the machining phase.
vpd:step-cnc-machining
    a wild:ParallelActivity ;
    dcterms:title            "Step 2: CNC Precision Machining"@en ;
    dcterms:description      "Blanks are clamped on CNC turning and milling centres for precision material removal to final dimensions. Spindle temperature is monitored to prevent thermal drift, and bearing vibration is tracked to detect developing faults before they cause scrap or unplanned downtime."@en ;
    wild:hasChildActivities  (
        vpd:wfact-cnc-temperature
        vpd:wfact-cnc-vibration
    ) .

vpd:wfact-cnc-temperature
    a wild:AtomicActivity ;
    dcterms:title       "CNC Temperature Monitoring"@en ;
    dcterms:description "Continuous acquisition of spindle motor, coolant, and enclosure temperatures to detect thermal drift during cutting operations."@en .

vpd:wfact-cnc-vibration
    a wild:AtomicActivity ;
    dcterms:title       "CNC Vibration Condition Monitoring"@en ;
    dcterms:description "Continuous tri-axial vibration monitoring of spindle bearing housings to identify wear signatures and trigger predictive maintenance actions."@en .

# Step 3 — atomic: the single monitoring activity is the hydraulic
# pressure observation.
vpd:step-hydraulic-forming
    a wild:AtomicActivity ;
    dcterms:title       "Step 3: Hydraulic Forming & Stamping"@en ;
    dcterms:description "Machined parts are transferred to Hall B where hydraulic presses perform stamping, deep drawing, and bending to achieve final geometry. Hydraulic circuit pressure is recorded for every press cycle to verify forming force and detect seal or accumulator faults in real time."@en .

# Step 4 — atomic: final inspection and dispatch. No sensor observation
# dataset is currently associated with this step; process records from
# Steps 1–3 are used for traceability.
vpd:step-quality-dispatch
    a wild:AtomicActivity ;
    dcterms:title       "Step 4: Quality Inspection & Dispatch"@en ;
    dcterms:description "Finished parts undergo dimensional verification on a coordinate measuring machine (CMM) and visual surface inspection. Each accepted part receives a traceability label linking it to the process records from Steps 1–3. Approved batches are packaged and transferred to the dispatch area."@en .

# ---------------------------------------------------------------------------
# Manufacturing Workflow Instance (WiLD)
#
# Runtime execution of the workflow model above. The four sensor observations
# are the activity instances of this workflow instance. Each observation is
# typed as wild:ActivityInstance with wild:hasState wild:done, which is
# semantically equivalent to prov:Activity (completed activity).
# The instance itself remains wild:active because Step 4 has no completed
# activity instance yet.
# ---------------------------------------------------------------------------

vpd:wfinst-manufacturing-line
    a wild:WorkflowInstance ;
    dcterms:title          "Manufacturing Line Process — Active Instance"@en ;
    dcterms:description    "Running execution of the manufacturing line workflow. Sensor observations from Steps 1–3 are recorded as completed activity instances. Step 4 (quality inspection) has no associated observation dataset in this instance."@en ;
    wild:workflowInstanceOf vpd:workflow-manufacturing-line ;
    wild:hasState           wild:active ;
    prov:startedAtTime      "2023-01-01T00:00:00Z"^^xsd:dateTime .
