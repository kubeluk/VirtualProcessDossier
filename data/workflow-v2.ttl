### Pressing

<1#forming> a wild:ParallelActivity ;
    sosa:implementedBy machine:press
    param:pressForce [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Force ;
        qudt:hasUnit unit:KiloN ;
        qudt:value 1000.0
    ] ;
    param:coolingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 60.0
    ] ;
    param:remainingPressPath [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Distance ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 0.0
    ] ;
    param:closingSpeedSteps (
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 80.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 60.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 60.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 25.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 35.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 10.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 10.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 0.0
            ]
        ]
    ) ;
    wild:hasChildActivities ( <1#formingUpper> <1#formingLower> )
    for:hasSubPlan <1#formingUpper> ;
    for:hasSubPlan <1#formingLower> .

<1#formingUpper> a wild:AtomicActivity ;
    sosa:implementedBy machine:pressMoldUpper ;
    param:moldTemperature [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Temperature ;
        qudt:hasUnit unit:DEG_C ;
        qudt:value 110.0
    ] .

<1#formingLower> a wild:AtomicActivity ;
    sosa:implementedBy machine:pressMoldLower ;
    param:moldTemperature [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Temperature ;
        qudt:hasUnit unit:DEG_C ;
        qudt:value 110.0
    ] .