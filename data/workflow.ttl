# Workflow Model

## Stamp Forming Flow

workflow:stampForming a wild:WorkflowModel ;
    rdfs:label "Stamp Forming Flow" ;
    rdfs:comment "Workflow for the stamp forming process of a composite laminate." ;
    wild:hasBehaviour workflow:stampForming_root .

workflow:stampForming_root a wild:ParallelActivity ;
    rdfs:label "Stamp Forming Behaviour" ;
    wild:hasChildActivities ( activity:gripping workflow:heatingTransferingForming ) .

workflow:heatingTransferingForming a wild:SequentialActivity ;
    rdfs:label "Heating and Forming" ;
    wild:hasChildActivities ( activity:heating activity:transfering activity:forming ) .

activity:gripping a wild:AtomicActivity ;
    rdfs:label "Gripping" ;
    rdfs:comment "The gripping activity involves the use of the gripper frame to hold the laminate in place during the heating and forming activities." .

activity:heating a wild:AtomicActivity ;
    rdfs:label "Heating" ;
    rdfs:comment "The heating activity involves the use of the IR oven to heat the laminate to the desired temperature." .

activity:transfering a wild:AtomicActivity ;
    rdfs:label "Transfering" ;
    rdfs:comment "The transfering activity involves moving the laminate from the heating station to the press." .

activity:forming a wild:AtomicActivity ;
    rdfs:label "Forming" ;
    rdfs:comment "The forming activity involves the use of the press to shape the laminate." .