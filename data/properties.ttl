@base <http://purl.org/for/> .

@prefix prop: <http://purl.org/for/property#>
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

prop:surfaceTemperature a sosa:ObservableProperty ;
    rdfs:label "Surface Temperature"@en .

prop:surfaceGeometry a sosa:ObservableProperty ;
    rdfs:label "Surface Geometry"@en ;
    rdfs:comment "The surface geometry of an object in 3D"@en .

prop:angle a sosa:ObservableProperty ;
    rdfs:label "Angle"@en .

prop:force a sosa:ObservableProperty ;
    rdfs:label "Force"@en .

prop:extension a sosa:ObservableProperty ;
    rdfs:label "Extension"@en .