@base <http://purl.org/for/fofa/> .

@prefix pos: <http://purl.org/for/position#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

<property/temperature/surface#it> a sosa:ObservableProperty ;
    rdfs:label "Surface Temperature"@en .

<property/geometry/surface#it> a sosa:ObservableProperty ;
    rdfs:label "Surface Geometry"@en ;
    rdfs:comment "The surface geometry of an object in 3D"@en .

<property/angle#it> a sosa:ObservableProperty ;
    rdfs:label "Angle"@en .

<property/force#it> a sosa:ObservableProperty ;
    rdfs:label "Force"@en .

<property/extension#it> a sosa:ObservableProperty ;
    rdfs:label "Extension"@en .