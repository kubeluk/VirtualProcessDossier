@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex:   <http://example.org/vpd/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix fofa: <http://purl.org/fofa/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

fofa:Material a rdfs:Class ;
    rdfs:label "Material" ;
    rdfs:comment "A material used in the manufacturing process, such as a metal, plastic, or composite." .

fofa:Sheet a rdfs:Class ;
    rdfs:label "Sheet" ;
    rdfs:comment "A flat, thin piece of material, often used as a raw material in manufacturing." .

fofa:pa6cf a fofa:Material ;
    rdfs:label "PA6CF" ;
    rdfs:comment "Polyamide 6 with carbon fiber reinforcement, commonly used in high-performance applications." .

fofa:sheet1 a fofa:Sheet .