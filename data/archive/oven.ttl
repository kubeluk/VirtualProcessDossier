@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex:   <http://example.org/vpd/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix fofa: <http://purl.org/fofa/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

fofa:oven
    a ssn:System, sosa:Actuator, sosa:FeatureOfInterest ;
    rdfs:label "Oven" ;
    sosa:hasProperty fofa:ovenHeatingTemperatureParameter ,
        fofa:ovenUpperTemperatureParameter ,
        fofa:ovenLowerTemperatureParameter ,
        fofa:ovenHeatingTimeParameter ,
        fofa:ovenPreheatingTimeParameter ,
        fofa:ovenHeatingPowerParameter ,
        fofa:ovenHoldingTimeActual ,
        fofa:ovenUpperTemperatureActual ,
        fofa:ovenLowerTemperatureActual ,
        fofa:ovenPreheatingTimeActual ,
        fofa:ovenHeatingPowerActual .

# Observable

fofa:ovenHoldingTimeActual
    a sosa:ObservableProperty ;
    rdfs:comment "The oven's observable holding time during operation" .

fofa:ovenUpperTemperatureActual
    a sosa:ObservableProperty ;
    rdfs:comment "The oven's observable upper temperature during operation" .

fofa:ovenLowerTemperatureActual
    a sosa:ObservableProperty ;
    rdfs:comment "The oven's observable lower temperature during operation" .

fofa:ovenPreheatingTimeActual
    a sosa:ObservableProperty ;
    rdfs:comment "The oven's observable preheating time during operation" .

fofa:ovenHeatingPowerActual
    a sosa:ObservableProperty ;
    rdfs:comment "The oven's observable heating power during operation" .

# Parameters

## Temperatures 

fofa:ovenUpperTemperatureParameter
    a sh:NodeShape ;
    rdfs:comment "The oven's upper temperature parameter setting" ;
    sh:node fofa:temperatureParameterShape .

fofa:ovenLowerTemperatureParameter
    a sh:NodeShape ;
    rdfs:comment "The oven's lower temperature parameter setting" ;
    sh:node fofa:temperatureParameterShape .
    
fofa:temperatureParameterShape
    a sh:NodeShape ;
    sh:targetClass qudt:Quantity ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue quantitykind:Temperature ;
    ] ;
    sh:property [
        sh:path qudt:quantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:hasUnit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG_C ;
            ] ;
            sh:property [
                sh:path qudt:value ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ]
        ]
    ] .

## Duration

fofa:ovenHeatingTimeParameter
    a sh:NodeShape ;
    rdfs:comment "The oven's heating time parameter setting" ;
    sh:node fofa:timeParameterShape .

fofa:ovenPreheatingTimeParameter
    a sh:NodeShape ;
    rdfs:comment "The oven's preheating time parameter setting" ;
    sh:node fofa:timeParameterShape .

fofa:timeParameterShape
    a sh:NodeShape ;
    sh:targetClass qudt:Quantity ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue quantitykind:Time ;
    ] ;
    sh:property [
        sh:path qudt:quantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:hasUnit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:Second ;
            ] ;
            sh:property [
                sh:path qudt:value ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ]
        ]
    ] .

## Power

fofa:ovenHeatingPowerParameter
    a sh:NodeShape ;
    rdfs:comment "The oven's heating power parameter setting" ;
    sh:node fofa:powerParameterShape .

fofa:powerParameterShape
    a sh:NodeShape ;
    sh:targetClass qudt:Quantity ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue quantitykind:Power ;
    ] ;
    sh:property [
        sh:path qudt:quantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:hasUnit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:Watt ;
            ] ;
            sh:property [
                sh:path qudt:value ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ]
        ]
    ] .

# Example

## Params

ex:ovenParam1
    a qudt:Quantity ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:quantityValue [
        a qudt:QuantityValue ;
        qudt:hasUnit unit:DEG_C ;
        qudt:value 200.0 ;
    ] ;
    prov:wasAssociatedWith fofa:oven ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent fofa:oven ;
        prov:hadRole fofa:ovenUpperTemperatureParameter ;
    ] .

ex:ovenParam2
    a qudt:Quantity ;
    qudt:hasQuantityKind quantitykind:Time ;
    qudt:quantityValue [
        a qudt:QuantityValue ;
        qudt:hasUnit unit:Second ;
        qudt:value 3600.0 ;
    ] ;
    prov:wasAssociatedWith fofa:oven ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent fofa:oven ;
        prov:hadRole fofa:ovenHeatingTimeParameter ;
    ] .

ex:ovenParam3
    a qudt:Quantity ;
    qudt:hasQuantityKind quantitykind:Power ;
    qudt:quantityValue [
        a qudt:QuantityValue ;
        qudt:hasUnit unit:Watt ;
        qudt:value 1500.0 ;
    ] ;
    prov:wasAssociatedWith fofa:oven ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent fofa:oven ;
        prov:hadRole fofa:ovenHeatingPowerParameter ;
    ] .

## Procedure

fofa:stampForming
    a wild:WorkflowModel ;
    rdfs:label "Stamp Forming" ;
    wild:hasBehavior fofa:stampFormingBehavior .

fofa:stampFormingBehavior
    a wild:SequentialActivity ;
    rdfs:label "Stamp Forming Behavior" ;
    wild:hasChildActivities ( fofa:heating fofa:forming ) .

fofa:heating
    a wild:AtomicActivity, sosa:Procedure ;
    rdfs:label "Heating" ;
    ssn:implementedBy fofa:oven .

fofa:forming
    a wild:AtomicActivity, sosa:Procedure ;
    rdfs:label "Forming" ;
    ssn:implementedBy ex:press .

## Execution

ex:heatingExec1
    a wild:ActivityInstance ;
    wild:activityInstanceOf fofa:heating ;
    prov:used ex:ovenParam1, ex:ovenParam2, ex:ovenParam3 .