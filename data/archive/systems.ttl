@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex:   <http://example.org/vpd/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix fofa: <http://purl.org/fofa/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# T-Box

fofa:PressParameterization a rdfs:Class .
fofa:ParameterValue a rdfs:Class .

fofa:hasParameterValue a rdf:Property ;
    rdfs:domain fofa:PressParameterization ;
    rdfs:range fofa:ParameterValue .

fofa:forProperty a rdf:Property ;
    rdfs:domain fofa:ParameterValue ;
    rdfs:range ssn:Property .

fofa:targetsSystem a rdf:Property ;
    rdfs:domain fofa:PressParameterization ;
    rdfs:range ssn:System .

# A-Box

fofa:press a ssn:System ;
    ssn:hasProperty fofa:pressSpeed ,
                    fofa:pressForce ,
                    fofa:pressDuration ,
                    fofa:pressToolTemperature .

fofa:pressSpeed a ssn:Property .
fofa:pressForce a ssn:Property .
fofa:pressDuration a ssn:Property .
fofa:pressToolTemperature a ssn:Property .

## Gripper Frame

