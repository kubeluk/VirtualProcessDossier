@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex:   <http://example.org/vpd/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix fofa: <http://purl.org/fofa/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# Datasets

fofa:PressParamDataset_v1 a dcat:Dataset ;
    dct:title "Press Parameterization - Step A (v1)" ;
    dct:description "Parameterization of a press using SSN properties and QUDT values." ;
    dct:created "2026-04-10T10:00:00Z"^^xsd:dateTime ;
    dct:creator fofa:ProcessEngineer1 ;
    dcat:distribution fofa:PressParamDistribution_v1 .

fofa:PressParamDistribution_v1 a dcat:Distribution ;
    dcat:mediaType "text/turtle" ;
    dct:conformsTo fofa:PressParamShape_v1 ;
    dcat:downloadURL <http://example.org/data/press-params-v1.ttl> ;
    prov:generatedAtTime "2026-04-10T10:00:00Z"^^xsd:dateTime .

# Systems and Properties

fofa:press1 a ssn:System ;
    ssn:hasProperty fofa:pressSpeed ,
                    fofa:pressForce ,
                    fofa:pressDuration ,
                    fofa:pressToolTemperature .

fofa:pressSpeed a ssn:Property .
fofa:pressForce a ssn:Property .
fofa:pressDuration a ssn:Property .
fofa:pressToolTemperature a ssn:Property .

fofa:PressParameterization a rdfs:Class .
fofa:ParameterValue a rdfs:Class .

fofa:hasParameterValue a rdf:Property ;
    rdfs:domain fofa:PressParameterization ;
    rdfs:range fofa:ParameterValue .

fofa:forProperty a rdf:Property ;
    rdfs:domain fofa:ParameterValue ;
    rdfs:range ssn:Property .

fofa:targetsSystem a rdf:Property ;
    rdfs:domain fofa:PressParameterization ;
    rdfs:range ssn:System .

# Parameterization Instance

fofa:parameterization1 a fofa:PressParameterization ;
    fofa:targetsSystem fofa:press1 ;

    fofa:hasParameterValue [
        fofa:forProperty fofa:pressSpeed ;
        qudt:numericValue "0.5"^^xsd:double ;
        qudt:unit unit:M-PER-SEC
    ] ;

    fofa:hasParameterValue [
        fofa:forProperty fofa:pressForce ;
        qudt:numericValue "10000"^^xsd:double ;
        qudt:unit unit:N
    ] ;

    fofa:hasParameterValue [
        fofa:forProperty fofa:pressDuration ;
        qudt:numericValue "5"^^xsd:double ;
        qudt:unit unit:SEC
    ] ;

    fofa:hasParameterValue [
        fofa:forProperty fofa:pressToolTemperature ;
        qudt:numericValue "180"^^xsd:double ;
        qudt:unit unit:DEG_C
    ] .

# Parameter Shape

ex:PressParamShape_v1 a sh:NodeShape ;
    sh:targetClass ex:PressParameterization ;

    # Must target exactly one system
    sh:property [
        sh:path ex:targetsSystem ;
        sh:class ssn:System ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # Must have parameter values
    sh:property [
        sh:path ex:hasParameterValue ;
        sh:class ex:ParameterValue ;
        sh:minCount 4 ;
    ] .

ex:ParameterValueShape a sh:NodeShape ;
    sh:targetClass ex:ParameterValue ;

    sh:property [
        sh:path ex:forProperty ;
        sh:class ssn:Property ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

#####

@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix ex:   <http://example.org/vpd/> .
@prefix wild: <http://example.org/wild/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Catalog
#################################################################

ex:VPDCatalog a dcat:Catalog ;
    dct:title "VPD Manufacturing Knowledge Catalog" ;
    dcat:dataset ex:PressParamDataset_v1 ,
                 ex:ObservationDataset_Run001 .

#################################################################
# Machine + Properties
#################################################################

ex:Press1 a ssn:System ;
    ssn:hasProperty ex:PressSpeed ,
                    ex:PressForce ,
                    ex:PressDuration ,
                    ex:ToolTemperature .

ex:PressSpeed a ssn:Property .
ex:PressForce a ssn:Property .
ex:PressDuration a ssn:Property .
ex:ToolTemperature a ssn:Property .

#################################################################
# Parameterization Dataset
#################################################################

ex:PressParamDataset_v1 a dcat:Dataset ;
    dct:title "Press Parameterization v1" ;
    dcat:distribution ex:PressParamDist_v1 .

ex:PressParamDist_v1 a dcat:Distribution ;
    dcat:mediaType "text/turtle" ;
    dcat:downloadURL <http://example.org/data/press-params-v1.ttl> .

#################################################################
# Parameterization Instance
#################################################################

ex:ParamInstance_v1 a ex:PressParameterization ;
    ex:targetsMachine ex:Press1 ;

    ex:hasParameterValue ex:ParamSpeed ,
                         ex:ParamForce ,
                         ex:ParamDuration ,
                         ex:ParamTemperature .

ex:ParamSpeed a ex:ParameterValue ;
    ex:forProperty ex:PressSpeed ;
    qudt:numericValue "0.5"^^xsd:double ;
    qudt:unit unit:M-PER-SEC .

ex:ParamForce a ex:ParameterValue ;
    ex:forProperty ex:PressForce ;
    qudt:numericValue "10000"^^xsd:double ;
    qudt:unit unit:N .

ex:ParamDuration a ex:ParameterValue ;
    ex:forProperty ex:PressDuration ;
    qudt:numericValue "5"^^xsd:double ;
    qudt:unit unit:SEC .

ex:ParamTemperature a ex:ParameterValue ;
    ex:forProperty ex:ToolTemperature ;
    qudt:numericValue "180"^^xsd:double ;
    qudt:unit unit:DEG_C .

#################################################################
# Observation Dataset (Time Series बाह KG)
#################################################################

ex:ObservationDataset_Run001 a dcat:Dataset ;
    dct:title "Observations Run 001" ;
    prov:wasGeneratedBy ex:Actuation_Run001 ;
    ex:observesProperty ex:PressSpeed ,
                        ex:PressForce ,
                        ex:ToolTemperature ;
    ex:hasFeatureOfInterest ex:Press1 ;
    dcat:distribution ex:ObservationDist_Run001 .

ex:ObservationDist_Run001 a dcat:Distribution ;
    dcat:mediaType "text/csv" ;
    dcat:downloadURL <http://datalake.example.org/press/run001.csv> ;
    ex:hasMapping <http://example.org/mappings/run001-mapping.ttl> .