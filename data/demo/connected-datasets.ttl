@base <http://purl.org/for/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic UI fixtures. These are not measured production records.
<vpd#it> dcat:dataset <demo/dataset#temperature>, <demo/dataset#force>, <demo/dataset#geometry> .

<demo/dataset#temperature> a dcat:Dataset ;
    dct:title "Example laminate surface temperature" ;
    dct:description "Synthetic temperature data demonstrating a dataset connected to a laminate observation and production run." ;
    prov:wasGeneratedBy <workflow/instance/1#observeLaminateSurfaceTemperature1> ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:downloadURL <http://localhost:8080/example-data/temperature.tsv> ;
        dcat:mediaType "text/tab-separated-values" ;
        dcat:temporalResolution "PT1S"^^xsd:duration
    ] .

<demo/dataset#force> a dcat:Dataset ;
    dct:title "Example gripper 1 force" ;
    dct:description "Synthetic force data. Its feature of interest is a gripper, not the run's input laminate." ;
    prov:wasGeneratedBy <workflow/instance/1#observeGripperForce1> ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:downloadURL <http://localhost:8080/example-data/force.tsv> ;
        dcat:mediaType "text/tab-separated-values" ;
        dcat:temporalResolution "PT1S"^^xsd:duration
    ] .

<demo/dataset#geometry> a dcat:Dataset ;
    dct:title "Example inspection geometry" ;
    dct:description "Synthetic triangle mesh demonstrating an inspection dataset; it is not a scan of a manufactured part." ;
    prov:wasGeneratedBy <workflow/instance/1#observeLaminateShape1> ;
    dcat:distribution [
        a dcat:Distribution ;
        dcat:downloadURL <http://localhost:8080/example-data/geometry.stl> ;
        dcat:mediaType "model/stl"
    ] .
