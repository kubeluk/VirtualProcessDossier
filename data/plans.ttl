## Heating

plan:1_heating a prov:Plan, prov:Collection ;
    prov:hadMember [
        a prov:Plan ;
        param:temperatureGoal [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value 280.0
            ] ;
            prov:wasDerivedFrom machine:ir_top
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 80.0
            ] ;
            prov:wasDerivedFrom machine:ir_top_middle
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 20.0
            ] ;
            prov:wasDerivedFrom machine:ir_top_edge
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 20.0
            ] ;
            prov:wasDerivedFrom machine:ir_top_corner
        ]
    ] ;
    prov:hadMember [
        a prov:Plan ;
        param:temperatureGoal [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value 280.0
            ] ;
            prov:wasDerivedFrom machine:ir_bottom
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 100.0
            ] ;
            prov:wasDerivedFrom machine:ir_bottom_middle
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 20.0
            ] ;
            prov:wasDerivedFrom machine:ir_bottom_edge
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 20.0
            ] ;
            prov:wasDerivedFrom machine:ir_bottom_corner
        ]
    ] ;
    param:holdingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 5.0
    ] .

## Pressing

plan:1_press a prov:Plan ;
    prov:wasDerivedFrom machine:press ;
    param:tool :Drapiernapf ;
    param:pressForce [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Force ;
        qudt:hasUnit unit:KiloN ;
        qudt:value 1000.0
    ] ;
    param:coolingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 60.0
    ] ;
    param:remainingPressPath [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Distance ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 0.0
    ] ;
    param:moldTemperature [
        a prov:Entity ;
        prov:value [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
        prov:wasDerivedFrom machine:press_mold_upper
    ] ;
    param:moldTemperature [
        a prov:Entity ;
        prov:value [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
        prov:wasDerivedFrom machine:press_mold_lower
    ] ;
    param:closingSpeedSteps (
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 80.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 60.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 60.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 25.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 35.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 10.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 10.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 0.0
            ]
        ]
    ) .