### Heating

plan:100_heating a prov:Plan, prov:Collection ;
    prov:hadMember [
        a prov:Plan ;
        param:temperatureGoal [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value 280.0
            ] ;
            prov:wasDerivedFrom machine:ir_top
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 80.0
            ] ;
            prov:wasDerivedFrom machine:ir_top_middle
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 20.0
            ] ;
            prov:wasDerivedFrom machine:ir_top_edge
        ] ;
        param:zoneControl [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:PERCENT ;
                qudt:value 20.0
            ] ;
            prov:wasDerivedFrom machine:ir_top_corner
