    ] ;
    param:holdingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 10.0
    ] .

### Pressing

plan:100_press a prov:Plan ;
    prov:wasDerivedFrom machine:press ;
    param:tool :Drapiernapf ;
    param:pressForce [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Force ;
        qudt:hasUnit unit:KiloN ;
        qudt:value 0.0
    ] ;
    param:coolingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 60.0
    ] ;
    param:remainingPressPath [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Distance ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 10.0
    ] ;
    param:moldTemperature [
        a prov:Entity ;
        prov:value [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
        prov:wasDerivedFrom machine:press_mold_upper
    ] ;
    param:moldTemperature [
        a prov:Entity ;
        prov:value [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
        prov:wasDerivedFrom machine:press_mold_lower
    ] ;
    param:closingSpeedSteps (
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 80.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 60.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 60.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 25.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 35.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 15.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 5.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 13.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 0.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 12.5
            ]
        ]
        [
