# Plans

## Gripping

plan:1_gripping a prov:Plan, prov:Collection ;
    prov:hadMember [
        a prov:Plan ;
        prov:wasDerivedFrom gripper:1 ;
        param:gripperPosition [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:PositionVector ;
                qudt:hasUnit unit:MilliM ;
                qudt:value ( 210.0 100.0 )
            ] ;
            prov:wasDerivedFrom pos:gripperFrameReferencePoint ;
        ] ;
        param:setpoint [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
            ] ;
            prov:wasDerivedFrom activity:heating
        ] ;
        param:setpoint [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
            ] ;
            prov:wasDerivedFrom activity:forming
        ] ;
        param:setpoint [
            a prov:Entity ;
            prov:value [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 0
            ] ;
            prov:wasDerivedFrom activity:reworking
        ]
    ] ;
    prov:hadMember [
        a prov:Plan ;
        prov:wasDerivedFrom gripper:2 ;
        param:gripperPosition [
            a prov:Entity ;
            prov:value [
