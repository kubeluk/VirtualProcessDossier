# Extraction Changelog

extract:1 a prov:Activity ;
    rdfs:label "RDF Triple Construction 1" ;
    rdfs:comment "Construction of RDF triples related to part 1." ;
    rdfs:comment "No issues were encountered during the extraction process." ;
    prov:wasAssociatedWith [
        a prov:Person 
    ] ;
    prov:generated part:1, laminat:1, pos:1, pos:2, pos:3, pos:4, pos:5, pos:6, pos:7, pos:8, layup:1, tape:1, tape:2, tape:3, tape:4, tape:5, tape:6 .

# Extracted Triples

## Static Common Knowledge

pos:laminatReferencePoint a pos:Origin ;
    rdfs:label "Laminat Reference Point"@en ;
    rdfs:comment "Die Mitte des Laminats bildet den Bezugspunkt für die Positionen der Greiferpunkte."@de .

## Extracted Material Triples

### Part 1

part:1 a prov:Entity, sosa:Sample ;
    sosa:isResultOf run:1 ;
    sosa:isSampleOf feature:processMaturityLevel ;
    prov:wasDerivedFrom laminat:1 ;
    prov:qualifiedDerivation [
        a prov:Derivation ;
        prov:entity laminat:1 ;
        prov:hadActivity run:1
    ] .

#### Laminat

laminat:1 a geo:Feature, prov:Entity ;
    rdfs:label "BASF PA6-GF60" ;
    dcterms:identifier "1_1" ;
    prov:wasDerivedFrom layup:1 ;
    geo:hasSize [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Length ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 400.0
    ] ;
    geo:hasSize [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Width ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 400.0
    ] ;
    geo:hasSize [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Thickness ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 1.56
    ] ;
    param:hasFiberMassFraction [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:MassFraction ;
        qudt:hasUnit unit:PERCENT ;
        qudt:value 60
    ] ;
    pos:hasPositionalReference pos:laminatReferencePoint ;
    param:hasNeedlePoint pos:1, pos:2, pos:3, pos:4, pos:5, pos:6, pos:7, pos:8 .

pos:1 a qudt:Quantity, prov:Entity ;
