#### Layup

layup:1 a prov:Entity ;
    rdfs:label "[0/60/120]s" ;
    prov:value ( tape:1 tape:2 tape:3 tape:4 tape:5 tape:6 ) ;
    prov:wasDerivedFrom tape:1, tape:2, tape:3, tape:4, tape:5, tape:6 ;
    prov:qualifiedDerivation [
        a prov:Derivation ;
        prov:entity tape:1 ;
