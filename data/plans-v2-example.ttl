### Heating

plan:1_heating a for:HeatingPlan ;
    for:useSystem machine:oven ;
    param:holdingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 5.0
    ] ;
    for:subPlan [
        a for:HeatingPlan ;
        for:useSystem machine:ir_top ;
        param:temperatureGoal [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        param:zoneControl [
            a qudt:Quantity ;
            qudt:hasUnit unit:PERCENT ;
            qudt:value 80.0
        ] ;
        param:zoneControl [
            a qudt:Quantity ;
            qudt:hasUnit unit:PERCENT ;
            qudt:value 20.0
        ] ;
        param:zoneControl [
            a qudt:Quantity ;
            qudt:hasUnit unit:PERCENT ;
            qudt:value 20.0
        ]
    ] ;
    for:subPlan [
        a for:HeatingPlan ;
        for:useSystem machine:ir_bottom
        param:temperatureGoal [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        param:zoneControl [
            a qudt:Quantity ;
            qudt:hasUnit unit:PERCENT ;
            qudt:value 100.0
        ] ;
        param:zoneControl [
            a qudt:Quantity ;
            qudt:hasUnit unit:PERCENT ;
            qudt:value 20.0
        ] ;
        param:zoneControl [
            a qudt:Quantity ;
            qudt:hasUnit unit:PERCENT ;
            qudt:value 20.0
        ]
    ] .

### Pressing

plan:1_forming a for:FormingPlan ;
    for:useSystem machine:press
    param:pressForce [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Force ;
        qudt:hasUnit unit:KiloN ;
        qudt:value 1000.0
    ] ;
    param:coolingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 60.0
    ] ;
    param:remainingPressPath [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Distance ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 0.0
    ] ;
    param:closingSpeedSteps (
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 80.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 60.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 60.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 25.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 35.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 10.0
            ]
        ]
        [
            param:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 10.0
            ] ;
            param:remaining [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 0.0
            ]
        ]
    ) ;
    for:subPlan [
        a for:PressPlan ;
        for:useSystem machine:press_mold_upper ;
        param:moldTemperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
    ] ;
    for:subPlan [
        a for:PressPlan ;
        for:useSystem machine:press_mold_lower ;
        param:moldTemperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
    ] .