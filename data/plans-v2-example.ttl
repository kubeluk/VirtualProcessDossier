@base <http://purl.org/for/> .

@prefix : <#> .
@prefix for: <http://purl.org/for/terms#>
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix part: <http://purl.org/for/part#> .
@prefix laminat: <http://purl.org/for/laminat#> .
@prefix layup: <http://purl.org/for/layup#> .
@prefix tape: <http://purl.org/for/tape#> .
@prefix run: <http://purl.org/for/run#> .
@prefix workflow: <http://purl.org/for/workflow#> .
@prefix feature: <http://purl.org/for/feature#> .
@prefix activity: <http://purl.org/for/activity#> .
@prefix machine: <http://purl.org/for/machine#> .
@prefix gripper: <http://purl.org/for/gripper#> .
@prefix plan: <http://purl.org/for/plan#> .
@prefix param: <http://purl.org/for/param#> .
@prefix tool: <http://purl.org/for/tool#> .
@prefix pos: <http://purl.org/for/position#> .
@prefix vpd: <http://purl.org/vpd/data#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wild: <http://purl.org/wild/vocab#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

# T Box

for:ManufacturingPlan a rdfs:Class ;
    rdfs:subClassOf prov:Plan .

for:GrippingPlan a for:ManufacturingPlan, rdfs:Class .

for:HeatingPlan a for:ManufacturingPlan, rdfs:Class .

for:FormingPlan a for:ManufacturingPlan, rdfs:Class .

for:subPlan a rdfs:Property ;
    rdfs:domain for:ManufacturingPlan ;
    rdfs:range for:ManufacturingPlan .

## Run 1

plan:1 a for:ManufacturingPlan ;
    for:useSystem machine:FoFaDemonstrator ;
    for:useActivity workflow:stampFormingFlow ;
    for:useInput <data/laminate/1#it> ;
    for:subPlan plan:1_gripping, plan:1_heating, plan:1_forming .

### Gripping

plan:1_gripping a for:GrippingPlan ;
    for:useSystem machine:gripperFrame ;
    for:useActivity activity:gripping ;
    for:subPlan [
        a for:GrippingPlan ;
        for:useSystem gripper:1 ;
        for:useActivity activity:gripping ;
        param:gripperPosition [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:PositionVector ;
            qudt:hasUnit unit:MilliM ;
            qudt:value ( 210.0 100.0 ) ;
            prov:wasDerivedFrom pos:gripperFrameReferencePoint 
        ] ;
        for:subPlan [
            for:useActivity activity:heating ;
            param:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
            ]
        ] ;
        for:subPlan [
            for:useActivity activity:forming ;
            param:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
            ]
        ]
    ] ;
    for:subPlan [
        a for:GrippingPlan ;
        for:useSystem gripper:2 ;
        for:useActivity activity:gripping ;
        param:gripperPosition [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:PositionVector ;
            qudt:hasUnit unit:MilliM ;
            qudt:value ( 210.0 -100.0 ) ;
            prov:wasDerivedFrom pos:gripperFrameReferencePoint
        ] ;
        for:subPlan [
            for:useActivity activity:heating ;
            param:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
            ]
        ] ;
        for:subPlan [
            for:useActivity activity:forming ;
            param:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
            ]
        ]
    ] ;
    for:subPlan [
        a for:GrippingPlan ;
        for:useSystem gripper:3 ;
        for:useActivity activity:gripping ;
        param:gripperPosition [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:PositionVector ;
            qudt:hasUnit unit:MilliM ;
            qudt:value ( -210.0 100.0 ) ;
            prov:wasDerivedFrom pos:gripperFrameReferencePoint 
        ] ;
        for:subPlan [
            for:useActivity activity:heating ;
            param:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value 60
