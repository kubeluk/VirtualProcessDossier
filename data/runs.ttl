@prefix : <#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix part: <http://purl.org/for/part#> .
@prefix laminat: <http://purl.org/for/laminat#> .
@prefix layup: <http://purl.org/for/layup#> .
@prefix tape: <http://purl.org/for/tape#> .
@prefix run: <http://purl.org/for/run#> .
@prefix workflow: <http://purl.org/for/workflow#> .
@prefix system: <http://purl.org/for/system#> .
@prefix feature: <http://purl.org/for/feature#> .
@prefix activity: <http://purl.org/for/activity#> .
@prefix machine: <http://purl.org/for/machine#> .
@prefix gripper: <http://purl.org/for/gripper#> .
@prefix plan: <http://purl.org/for/plan#> .
@prefix param: <http://purl.org/for/param#> .
@prefix tool: <http://purl.org/for/tool#> .
@prefix pos: <http://purl.org/for/position#> .
@prefix vpd: <http://purl.org/vpd/data#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wild: <http://purl.org/wild/vocab#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

# Workflow Runs

## Run 1

run:1 a wild:WorkflowInstance, sosa:Sampling, prov:Activity ;
    rdfs:label "Trial No. 1" ;
    rdfs:comment "Inbetriebnahme Heizfeld und Greiferrahmen" ;
    wild:workflowInstanceOf workflow:stampForming ;
    sosa:madeBySampler system:ict ;
    sosa:usedProcedure workflow:stampForming ;
    sosa:hasFeatureOfInterest feature:processMaturityLevel ;
    sosa:hasResult part:1 ;
    prov:startedAtTime "2026-03-30T10:19:00+02:00"^^xsd:dateTime ;
    wild:hasState wild:done .

run:1_root a wild:ActivityInstance, prov:Activity ;
    wild:inWorkflowInstance run:1 ;
    wild:activityInstanceOf workflow:stampForming_root ;
    wild:hasState wild:done .

run:1_heatingTransferingForming a wild:ActivityInstance, prov:Activity ;
    wild:inWorkflowInstance run:1 ;
    wild:activityInstanceOf workflow:heatingTransferingForming ;
    wild:hasState wild:done .

run:1_forming a wild:ActivityInstance, prov:Activity ;
    wild:inWorkflowInstance run:1 ;
    wild:activityInstanceOf activity:forming ;
    prov:wasAssociatedWith machine:press ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent machine:press ;
        prov:hadPlan plan:1_press
    ] ;
    wild:hasState wild:done .

run:1_transfering a wild:ActivityInstance, prov:Activity ;
    wild:inWorkflowInstance run:1 ;
    wild:activityInstanceOf activity:transfering ;
    wild:hasState wild:done .

run:1_heating a wild:ActivityInstance, prov:Activity ;
    wild:inWorkflowInstance run:1 ;
    wild:activityInstanceOf activity:heating ;
    prov:wasAssociatedWith machine:oven ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent machine:oven ;
        prov:hadPlan plan:1_heating
    ] ;
    wild:hasState wild:done .

run:1_gripping a wild:ActivityInstance, prov:Activity ;
    wild:inWorkflowInstance run:1 ;
    wild:activityInstanceOf activity:gripping ;
    prov:wasAssociatedWith machine:gripperFrame ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent machine:gripperFrame ;
        prov:hadPlan plan:1_gripping
    ] ;
    wild:hasState wild:done .

