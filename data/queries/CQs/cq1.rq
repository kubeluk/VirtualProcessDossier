PREFIX param: <http://purl.org/for/param#>
PREFIX plan: <http://purl.org/for/plan#>
PREFIX machine: <http://purl.org/for/machine#>
PREFIX run: <http://purl.org/for/run#>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX workflow: <http://purl.org/for/workflow#>
PREFIX vpd: <http://purl.org/vpd/data#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?datasetURI WHERE {
  BIND(<http://purl.org/for/part#1> AS ?part)
  ?part a sosa:Sample .
  ?part sosa:isResultOf ?run .
  ?run a wild:WorkflowInstance .
  OPTIONAL {
    ?dataset prov:wasGeneratedBy ?run ;
             dcat:distribution/dcat:downloadURL ?datasetURI .
  }
  OPTIONAL {
    ?dataset prov:wasDerivedFrom ?part ;
             dcat:distribution/dcat:downloadURL ?datasetURI .
  }
  OPTIONAL {
    ?activityInstance wild:inWorkflowInstance ?run .
    ?dataset sosa:isResultOf ?activityInstance ;
             dcat:distribution/dcat:downloadURL ?datasetURI .
  }
}