BASE <http://purl.org/for/>

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX workflow: <http://purl.org/for/workflow#>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Finalize the run and its root behaviour, replacing any previous states.
DELETE
{
    ?workflow_run wild:hasState ?previous_run_state .
    ?workflow_behaviour wild:hasState ?previous_behaviour_state .
}
INSERT
{
    ?part
        a prov:Entity ;
        prov:wasDerivedFrom ?laminate ;
        prov:qualifiedDerivation ?derivation .

    ?derivation
        a prov:Derivation ;
        prov:entity ?laminate ;
        prov:hadActivity ?workflow_run .

    ?workflow_run
        a wild:WorkflowInstance, prov:Activity ;
        wild:workflowInstanceOf workflow:stampForming ;
        wild:hasState wild:done ;
        prov:startedAtTime ?run_start ;
        prov:endedAtTime ?run_end .

    ?workflow_behaviour
        a wild:ActivityInstance, prov:Activity ;
        wild:inWorkflowInstance ?workflow_run ;
        wild:activityInstanceOf activity:stampFormingFlow ;
        wild:hasState wild:done ;
        prov:startedAtTime ?behaviour_start ;
        prov:endedAtTime ?behaviour_end .
}
WHERE
{
    # TODO: create a unique part IRI.
    BIND(<part/000#it> AS ?part)

    # TODO: use the laminate, run, and root activity instance IRIs for this run.
    # The run IRI must match the one used by all of its activity queries.
    BIND(<laminate/000#it> AS ?laminate)
    BIND(<workflow/instance/000#it> AS ?workflow_run)
    BIND(<activity/instance/000#it> AS ?workflow_behaviour)

    # TODO: use the actual start and end times of the run and its root behaviour.
    BIND("2026-09-24T10:00:00Z"^^xsd:dateTime AS ?run_start)
    BIND("2026-09-24T10:02:34Z"^^xsd:dateTime AS ?run_end)
    BIND("2026-09-24T10:00:00Z"^^xsd:dateTime AS ?behaviour_start)
    BIND("2026-09-24T10:02:34Z"^^xsd:dateTime AS ?behaviour_end)

    # Allocate one derivation even if multiple previous states are present.
    BIND(BNODE() AS ?derivation)

    # OPTIONAL also allows finalizing a run with no previously recorded state.
    OPTIONAL { ?workflow_run wild:hasState ?previous_run_state }
    OPTIONAL { ?workflow_behaviour wild:hasState ?previous_behaviour_state }
}
