BASE <http://purl.org/for/>

PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX for: <http://purl.org/for/terms#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX oven: <http://purl.org/system/oven/1#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX quantitykind: <http://qudt.org/vocab/quantitykind/>
PREFIX unit: <http://qudt.org/vocab/unit/>

# Initialize an instance of activity:heating.
# Replace the BIND placeholders below with the requested initialization values.
# Placeholder defaults match data/plan.ttl.
INSERT
{
    ?activity_instance
        a wild:ActivityInstance ;
        wild:activityInstanceOf ?activity ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:hasState wild:initialized ;
        for:initialization ?system_parameterization .

    ?system_parameterization
        a prov:Plan ;
        for:initialized ?activity_instance ;
        oven:thresholdTemperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value ?threshold_temperature
        ] ;
        oven:stableHoldingTime [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Time ;
            qudt:hasUnit unit:SEC ;
            qudt:value ?stable_holding_time
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_1_target_temperature
            ] ;
            oven:atField <system/field/1#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_2_target_temperature
            ] ;
            oven:atField <system/field/2#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_3_target_temperature
            ] ;
            oven:atField <system/field/3#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_4_target_temperature
            ] ;
            oven:atField <system/field/4#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_5_target_temperature
            ] ;
            oven:atField <system/field/5#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_6_target_temperature
            ] ;
            oven:atField <system/field/6#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_7_target_temperature
            ] ;
            oven:atField <system/field/7#it>
        ] ;
        oven:fieldTargetTemperature [
            oven:fieldTarget [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:AreaTemperature ;
                qudt:hasUnit unit:DEG_C ;
                qudt:value ?field_8_target_temperature
            ] ;
            oven:atField <system/field/8#it>
        ] .
}
WHERE
{
    # TODO: replace 000 with a fresh UUID for every activity instance.
    # Keep this IRI when referring to the initialized activity instance.
    BIND(<activity/instance/000-heating#it> AS ?activity_instance)

    # Reference the activity exactly as declared in data/workflow.ttl.
    BIND(activity:heating AS ?activity)

    # TODO: use the same workflow instance IRI for all initialization queries.
    BIND(<workflow/instance/000#it> AS ?workflow_instance)

    # TODO: use a unique initialization plan IRI for this activity instance.
    BIND(<plan/000-heating#it> AS ?system_parameterization)

    # TODO: replace these example values with the initialization parameters.

    # Heating thresholds and holding time.
    BIND(260.0 AS ?threshold_temperature)
    BIND(5.0 AS ?stable_holding_time)

    # Target temperatures for each IR field.
    BIND(280.0 AS ?field_1_target_temperature)
    BIND(280.0 AS ?field_2_target_temperature)
    BIND(280.0 AS ?field_3_target_temperature)
    BIND(280.0 AS ?field_4_target_temperature)
    BIND(280.0 AS ?field_5_target_temperature)
    BIND(280.0 AS ?field_6_target_temperature)
    BIND(280.0 AS ?field_7_target_temperature)
    BIND(280.0 AS ?field_8_target_temperature)
}
