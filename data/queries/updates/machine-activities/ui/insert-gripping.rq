BASE <http://purl.org/for/>

PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX for: <http://purl.org/for/terms#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX frame: <http://purl.org/system/frame/1#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX quantitykind: <http://qudt.org/vocab/quantitykind/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX pos: <http://purl.org/for/position#>

# Initialize an instance of activity:gripping.
# Replace the BIND placeholders below with the requested initialization values.
# Placeholder defaults match data/run-view-after-ui.ttl.
INSERT
{
    ?activity_instance
        a wild:ActivityInstance ;
        wild:activityInstanceOf ?activity ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:hasState wild:initialized ;
        for:initialization ?system_parameterization .

    ?system_parameterization
        a prov:Plan ;
        for:initialized ?activity_instance ;
        frame:gripperPosition [
            frame:position [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:PositionVector ;
                qudt:hasUnit unit:MilliM ;
                qudt:value ( ?gripper_1_position_x ?gripper_1_position_y ) ;
                prov:wasDerivedFrom <http://purl.org/for/system/frame#referencePoint>
            ] ;
            frame:ofGripper <system/gripper/1#it>
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value ?gripper_1_gripping_setpoint ;
            ] ;
            frame:ofGripper <system/gripper/1#it> ;
            frame:atActivity activity:gripping
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value ?gripper_1_heating_setpoint ;
            ] ;
            frame:ofGripper <system/gripper/1#it> ;
            frame:atActivity activity:heating
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value ?gripper_1_pressing_setpoint ;
            ] ;
            frame:ofGripper <system/gripper/1#it> ;
            frame:atActivity activity:pressing
        ] ;
        frame:gripperPosition [
            frame:position [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:PositionVector ;
                qudt:hasUnit unit:MilliM ;
                qudt:value ( ?gripper_2_position_x ?gripper_2_position_y ) ;
                prov:wasDerivedFrom <http://purl.org/for/system/frame#referencePoint>
            ] ;
            frame:ofGripper <system/gripper/2#it>
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value ?gripper_2_gripping_setpoint ;
            ] ;
            frame:ofGripper <system/gripper/2#it> ;
            frame:atActivity activity:gripping
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value ?gripper_2_heating_setpoint ;
            ] ;
            frame:ofGripper <system/gripper/2#it> ;
            frame:atActivity activity:heating
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
                qudt:hasUnit unit:UNITLESS ;
                qudt:value ?gripper_2_pressing_setpoint ;
            ] ;
            frame:ofGripper <system/gripper/2#it> ;
            frame:atActivity activity:pressing
        ] ;
        frame:gripperPosition [
            frame:position [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:PositionVector ;
                qudt:hasUnit unit:MilliM ;
                qudt:value ( ?gripper_3_position_x ?gripper_3_position_y ) ;
                prov:wasDerivedFrom <http://purl.org/for/system/frame#referencePoint>
            ] ;
            frame:ofGripper <system/gripper/3#it>
        ] ;
        frame:gripperSetpoint [
            frame:setpoint [
                a qudt:Quantity ;
