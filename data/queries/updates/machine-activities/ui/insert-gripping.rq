        ] .
}
WHERE
{
    # TODO: replace 000 with a fresh UUID for every activity instance.
    # Keep this IRI when referring to the initialized activity instance.
    BIND(<activity/instance/000-gripping#it> AS ?activity_instance)

    # Reference the activity exactly as declared in data/workflow.ttl.
    BIND(activity:gripping AS ?activity)

    # TODO: use the same workflow instance IRI for all initialization queries.
    BIND(<workflow/instance/000#it> AS ?workflow_instance)

    # TODO: use a unique initialization plan IRI for this activity instance.
    BIND(<plan/000-gripping#it> AS ?system_parameterization)

    # TODO: replace these example values with the initialization parameters.

    # Gripper 1: position in millimeters and setpoints for each activity.
    BIND(210.0 AS ?gripper_1_position_x)
    BIND(100.0 AS ?gripper_1_position_y)
    BIND(60 AS ?gripper_1_gripping_setpoint)
    BIND(60 AS ?gripper_1_heating_setpoint)
    BIND(60 AS ?gripper_1_pressing_setpoint)

    # Gripper 2: position in millimeters and setpoints for each activity.
    BIND(210.0 AS ?gripper_2_position_x)
    BIND(-100.0 AS ?gripper_2_position_y)
    BIND(60 AS ?gripper_2_gripping_setpoint)
    BIND(60 AS ?gripper_2_heating_setpoint)
    BIND(60 AS ?gripper_2_pressing_setpoint)

    # Gripper 3: position in millimeters and setpoints for each activity.
    BIND(-210.0 AS ?gripper_3_position_x)
    BIND(100.0 AS ?gripper_3_position_y)
    BIND(60 AS ?gripper_3_gripping_setpoint)
    BIND(60 AS ?gripper_3_heating_setpoint)
    BIND(60 AS ?gripper_3_pressing_setpoint)

    # Gripper 4: position in millimeters and setpoints for each activity.
    BIND(-210.0 AS ?gripper_4_position_x)
    BIND(-100.0 AS ?gripper_4_position_y)
    BIND(60 AS ?gripper_4_gripping_setpoint)
    BIND(60 AS ?gripper_4_heating_setpoint)
    BIND(60 AS ?gripper_4_pressing_setpoint)

    # Gripper 5: position in millimeters and setpoints for each activity.
    BIND(100.0 AS ?gripper_5_position_x)
    BIND(210.0 AS ?gripper_5_position_y)
    BIND(60 AS ?gripper_5_gripping_setpoint)
    BIND(60 AS ?gripper_5_heating_setpoint)
    BIND(60 AS ?gripper_5_pressing_setpoint)

    # Gripper 6: position in millimeters and setpoints for each activity.
    BIND(-100.0 AS ?gripper_6_position_x)
    BIND(210.0 AS ?gripper_6_position_y)
    BIND(60 AS ?gripper_6_gripping_setpoint)
    BIND(60 AS ?gripper_6_heating_setpoint)
    BIND(60 AS ?gripper_6_pressing_setpoint)

    # Gripper 7: position in millimeters and setpoints for each activity.
    BIND(100.0 AS ?gripper_7_position_x)
    BIND(-210.0 AS ?gripper_7_position_y)
    BIND(60 AS ?gripper_7_gripping_setpoint)
    BIND(60 AS ?gripper_7_heating_setpoint)
    BIND(60 AS ?gripper_7_pressing_setpoint)

    # Gripper 8: position in millimeters and setpoints for each activity.
    BIND(-100.0 AS ?gripper_8_position_x)
    BIND(-210.0 AS ?gripper_8_position_y)
    BIND(60 AS ?gripper_8_gripping_setpoint)
    BIND(60 AS ?gripper_8_heating_setpoint)
    BIND(60 AS ?gripper_8_pressing_setpoint)
}
