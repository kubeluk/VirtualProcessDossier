BASE <http://purl.org/for/>

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Record a completed execution of activity:moveToOven.
INSERT
{
    ?activity_instance
        a prov:Activity, wild:ActivityInstance, sosa:Actuation ;
        prov:startedAtTime ?start_time ;
        prov:endedAtTime ?end_time ;
        wild:activityInstanceOf ?activity ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:hasState wild:done ;
        prov:wasAssociatedWith ?executing_system .
}
WHERE
{
    # TODO: replace 000 with a fresh UUID for every execution.
    # Keep this IRI when linking datasets or referring to this activity instance.
    BIND(<activity/instance/000-move-to-oven#it> AS ?activity_instance)

    # TODO: use the actual start and end times of this execution.
    BIND("2026-09-24T10:00:00Z"^^xsd:dateTime AS ?start_time)
    BIND("2026-09-24T10:02:34Z"^^xsd:dateTime AS ?end_time)

    # Reference the activity exactly as declared in data/workflow.ttl.
    BIND(activity:moveToOven AS ?activity)

    # TODO: use the same workflow instance IRI as in finalize-run.rq.
    BIND(<workflow/instance/000#it> AS ?workflow_instance)

    # TODO: use the actual executing system (or operator) IRI.
    # The demonstrator is a placeholder because no dedicated system for this step
    # is declared in systems-fofa.ttl.
    BIND(<http://purl.org/for/fofa/system/demonstrator#it> AS ?executing_system)

    # If a dedicated parameterization was applied, also record a
    # prov:qualifiedAssociation with prov:agent and prov:hadPlan as in
    # insert-machine-activity.rq.
}

