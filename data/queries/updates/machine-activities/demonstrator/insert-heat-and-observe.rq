BASE <http://purl.org/for/>

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Complete the initialized instance of activity:heatAndObserve.
# This update applies only while the instance is initialized.
DELETE
{
    ?activity_instance wild:hasState wild:initialized .
}
INSERT
{
    ?activity_instance
        wild:hasState wild:done ;
        prov:startedAtTime ?start_time ;
        prov:endedAtTime ?end_time .
}
WHERE
{
    # TODO: use the existing activity instance IRI created during initialization.
    BIND(<activity/instance/000-heat-and-observe#it> AS ?activity_instance)

    # TODO: use the actual start and end times of this activity execution.
    BIND("2026-09-24T10:00:00Z"^^xsd:dateTime AS ?start_time)
    BIND("2026-09-24T10:02:34Z"^^xsd:dateTime AS ?end_time)

    # Reference the activity declared in data/workflow.ttl.
    # Use the matching initialized activity instance.
    BIND(activity:heatAndObserve AS ?activity)

    # TODO: use the existing workflow instance IRI for this manufacturing run.
    BIND(<workflow/instance/000#it> AS ?workflow_instance)

    ?activity_instance
        a wild:ActivityInstance ;
        wild:activityInstanceOf ?activity ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:hasState wild:initialized .
}
