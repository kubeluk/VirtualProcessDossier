BASE <http://purl.org/for/>

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX vpd: <http://purl.org/for/vpd#>

# Record a dataset, link its producing sensor execution, and add its download URL.
INSERT
{
    vpd:it
        dcat:dataset ?dataset .

    ?dataset
        a dcat:Dataset ;
        prov:wasGeneratedBy ?sensor_activity_instance ;
        dcat:distribution [
            a dcat:Distribution ;
            dcat:downloadURL ?dataset_download_url
        ] .
}
WHERE
{
    # TODO: create a unique IRI for every dataset.
    BIND(<vpd/dataset/000#it> AS ?dataset)

    # TODO: use the exact activity instance IRI recorded by the sensor query.
    BIND(<activity/instance/000-observe-laminate-surface-temperature-1#it> AS ?sensor_activity_instance)

    # TODO: use the actual download URL for the data file.
    BIND(<https://os-webdav.lsdf.kit.edu/kit/iar/projects/FOR_5339/path/to/file> AS ?dataset_download_url)
}
