BASE <http://purl.org/for/>

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX activity: <http://purl.org/for/activity#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Record a completed execution of activity:observeGripperAngle1.
# Link its generated datasets separately with insert-dataset.rq.
# Complete only an existing initialized sensor activity instance.
DELETE
{
    ?sensor_activity_instance wild:hasState wild:initialized .
}
INSERT
{
    ?sensor_activity_instance
        a wild:ActivityInstance, sosa:Observation, prov:Activity ;
        prov:startedAtTime ?start_time ;
        prov:endedAtTime ?end_time ;
        wild:activityInstanceOf ?activity ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:hasState wild:done ;
        sosa:madeBySensor ?sensor ;
        sosa:hasFeatureOfInterest ?observed_entity ;
        sosa:observedProperty ?observed_property_of_entity .
}
WHERE
{
    # TODO: use the existing sensor activity instance IRI created during initialization.
    # Keep this IRI when linking datasets or referring to this activity instance.
    BIND(<activity/instance/000-observe-gripper-angle-1#it> AS ?sensor_activity_instance)

    # TODO: use the actual start and end times of this execution.
    BIND("2026-09-24T10:00:00Z"^^xsd:dateTime AS ?start_time)
    BIND("2026-09-24T10:02:34Z"^^xsd:dateTime AS ?end_time)

    # Reference the activity exactly as declared in data/workflow.ttl.
    # TODO: use the respective activity URI
    BIND(<activity#XYZ> AS ?activity)

    # TODO: use the existing workflow instance IRI for this manufacturing run.
    BIND(<workflow/instance/000#it> AS ?workflow_instance)

    # Sensor and observable property from systems.ttl and properties.ttl.
    # TODO: use the respective sensor URI
    BIND(<http://purl.org/for/sensor/XYZ/1#it> AS ?sensor)

    # The observed entity is gripper 1.
    # TODO: use the respective system (system.ttl) or laminate URI
    BIND(<http://purl.org/for/system-or-laminate/XYZ/000#it> AS ?observed_entity)

    # TOOD: use the respective property URI (properties.ttl)
    BIND(<http://purl.org/for/property#XYZ> AS ?observed_property_of_entity)

    ?sensor_activity_instance
        a wild:ActivityInstance ;
        wild:activityInstanceOf ?activity ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:hasState wild:initialized .
}
