BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX oven: <http://purl.org/system/oven/1#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>


SELECT ?oven_threshold_temperature ?oven_threshold_temperature_unit ?oven_stable_holding_time ?oven_stable_holding_time_unit
WHERE
{
	# TODO: use the actual workflow instance IRI that was generated by the VPD UI.
	BIND("PUT_WORKFLOW_INSTANCE_UUID_HERE" AS ?workflow_instance_uuid)
	BIND(IRI(CONCAT("http://purl.org/for/workflow/instance/", ?workflow_instance_uuid, "#it")) AS ?workflow_instance)

	?workflow_instance
		a wild:WorkflowInstance ;
		for:workflowInitialization/for:parameterization/prov:hadMember ?plan .

		?plan
			a prov:Plan ;
			oven:thresholdTemperature ?tT ;
            oven:stableHoldingTime ?sHT .

        ?tT
            qudt:value ?oven_threshold_temperature ;
            qudt:hasUnit ?oven_threshold_temperature_unit .

        ?sHT
            qudt:value ?oven_stable_holding_time ;
            qudt:hasUnit ?oven_stable_holding_time_unit .
}
