BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX wild: <http://purl.org/wild/vocab#>

# Input: scheduled workflow instance IRI. Keep this model-to-instance map.
# Use the existing instance IRI in completion updates and dataset provenance.
# All states are returned so the caller can detect completed or missing activities.
# Plans and implementing systems are optional: many activities have neither.
SELECT ?workflow_instance ?activity_instance ?activity ?activity_type ?state
       ?initialization_plan ?implementing_system
WHERE
{
    VALUES ?workflow_instance { <workflow/instance/1#it> }

    ?workflow_instance a wild:WorkflowInstance .
    ?activity_instance
        a wild:ActivityInstance ;
        wild:inWorkflowInstance ?workflow_instance ;
        wild:activityInstanceOf ?activity ;
        wild:hasState ?state .
    ?activity a ?activity_type .
    VALUES ?activity_type { wild:AtomicActivity wild:SequentialActivity wild:ParallelActivity }

    OPTIONAL { ?activity_instance for:initialization ?initialization_plan . }
    OPTIONAL { ?activity ssn:implementedBy ?implementing_system . }
}
ORDER BY ?activity ?activity_instance
