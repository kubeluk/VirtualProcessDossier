BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX frame: <http://purl.org/system/frame/1#>
PREFIX oven: <http://purl.org/system/oven/1#>
PREFIX press: <http://purl.org/system/press/1#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Input: scheduled workflow instance IRI.
# Return the applied plans with nested quantities and RDF lists intact.
# The structural path covers the current demonstrator plan vocabulary in plan.ttl.
# Extend it when introducing new nested parameter structures.
CONSTRUCT
{
    ?workflow_instance for:workflowInitialization ?workflow_initialization .
    ?workflow_initialization for:parameterization ?collection .
    ?collection a prov:Collection ; prov:hadMember ?initialization_plan .
    ?activity_instance for:initialization ?initialization_plan .
    ?subject ?predicate ?object .
}
WHERE
{
    VALUES ?workflow_instance { <workflow/instance/1#it> }

    ?workflow_instance a wild:WorkflowInstance .
    {
        ?workflow_instance for:workflowInitialization ?workflow_initialization .
        ?workflow_initialization for:parameterization ?collection .
        ?collection prov:hadMember ?initialization_plan .
    }
    UNION
    {
        ?activity_instance a wild:ActivityInstance ;
            wild:inWorkflowInstance ?workflow_instance ;
            for:initialization ?initialization_plan .
    }

    ?initialization_plan (
        frame:gripperPosition | frame:position | frame:gripperSetpoint | frame:setpoint |
        oven:thresholdTemperature | oven:stableHoldingTime |
        oven:fieldTargetTemperature | oven:fieldTarget |
        oven:heatingDeviceTargetTemperature | oven:deviceTemperature |
        press:force | press:moldCoolingTime | press:remainingPath |
        press:moldTemperature | press:temperature | press:closingSteps |
        press:closingSpeed | press:remainingDistance |
        qudt:value | rdf:first | rdf:rest
    )* ?subject .
    FILTER(?subject = ?initialization_plan || isBlank(?subject))
    ?subject ?predicate ?object .
}
