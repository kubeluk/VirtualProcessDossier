BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX press: <http://purl.org/system/press/1#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX list: <http://jena.apache.org/ARQ/list#>


SELECT ?step_index ?speed ?speed_unit ?distance ?distance_unit
WHERE
{
    # TODO: use the actual workflow instance IRI that was generated by the VPD UI.
    BIND("PUT_WORKFLOW_INSTANCE_UUID_HERE" AS ?workflow_instance_uuid)
    BIND(IRI(CONCAT("http://purl.org/for/workflow/instance/", ?workflow_instance_uuid, "#it")) AS ?workflow_instance)

    ?workflow_instance
        a wild:WorkflowInstance ;
        for:workflowInitialization/for:parameterization/prov:hadMember ?plan .

    ?plan
        a prov:Plan ;
        press:closingSteps ?steps .

    # Jena/Fuseki list indices start at zero.
    ?steps list:index (?step_index ?step) .
  
    ?step
        press:closingSpeed ?cs ;
        press:remainingDistance ?remaining .
  
  	?remaining
    	qudt:value ?distance ;
     	qudt:hasUnit ?distance_unit .
    
    ?cs
    	qudt:value ?speed ;
    	qudt:hasUnit ?speed_unit .
}
ORDER BY ?step_index
