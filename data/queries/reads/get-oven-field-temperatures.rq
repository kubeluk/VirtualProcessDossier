BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX oven: <http://purl.org/system/oven/1#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>


SELECT ?field_system ?system_label ?field_target_temp_value ?field_target_temp_unit
WHERE
{
	# TODO: use the actual workflow instance IRI that was generated by the VPD UI.
	BIND("PUT_WORKFLOW_INSTANCE_UUID_HERE" AS ?workflow_instance_uuid)
	BIND(IRI(CONCAT("http://purl.org/for/workflow/instance/", ?workflow_instance_uuid, "#it")) AS ?workflow_instance)

	?workflow_instance
		a wild:WorkflowInstance ;
		for:workflowInitialization/for:parameterization/prov:hadMember ?plan .

	?plan
		a prov:Plan ;
		oven:fieldTargetTemperature ?field_target_temp .
	
	?field_target_temp
		oven:fieldTarget ?fT ;
		oven:atField ?field_system .

	?fT
		qudt:value ?field_target_temp_value ;
		qudt:hasUnit ?field_target_temp_unit .

	?field_system
		rdfs:label ?system_label .
}
