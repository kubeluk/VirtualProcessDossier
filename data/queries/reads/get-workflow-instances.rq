BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wild: <http://purl.org/wild/vocab#>


SELECT ?workflow_instance
WHERE
{
    ?workflow_instance
        a wild:WorkflowInstance ;
        wild:hasState wild:initialized ;
        prov:generatedAtTime ?generation_time .
}
ORDER BY DESC(?generation_time)