BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX press: <http://purl.org/system/press/1#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>


SELECT ?force_value ?force_unit ?mold_cooling_time_value ?mold_cooling_time_unit ?remaining_path_value ?remaining_path_unit
WHERE
{
    # TODO: use the actual workflow instance IRI that was generated by the VPD UI.
    BIND("PUT_WORKFLOW_INSTANCE_UUID_HERE" AS ?workflow_instance_uuid)
    BIND(IRI(CONCAT("http://purl.org/for/workflow/instance/", ?workflow_instance_uuid, "#it")) AS ?workflow_instance)

    ?workflow_instance
        a wild:WorkflowInstance ;
        for:workflowInitialization/for:parameterization/prov:hadMember ?plan .

    ?plan
        a prov:Plan ;
        press:force ?force ;
        press:moldCoolingTime ?mold_cooling_time ;
        press:remainingPath ?remaining_path .

    ?force
        qudt:value ?force_value ;
        qudt:hasUnit ?force_unit .

    ?mold_cooling_time
        qudt:value ?mold_cooling_time_value ;
        qudt:hasUnit ?mold_cooling_time_unit .

    ?remaining_path
        qudt:value ?remaining_path_value ;
        qudt:hasUnit ?remaining_path_unit .
}