BASE <http://purl.org/for/>

PREFIX for: <http://purl.org/for/terms#>
PREFIX wild: <http://purl.org/wild/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX frame: <http://purl.org/system/frame/1#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>


SELECT ?gripper ?val_x ?val_y ?reference_description
WHERE
{
    # TODO: use the actual workflow instance IRI that was generated by the VPD UI.
    BIND("PUT_WORKFLOW_INSTANCE_UUID_HERE" AS ?workflow_instance_uuid)
    BIND(IRI(CONCAT("http://purl.org/for/workflow/instance/", ?workflow_instance_uuid, "#it")) AS ?workflow_instance)

    ?workflow_instance
        a wild:WorkflowInstance ;
        for:workflowInitialization/for:parameterization/prov:hadMember ?plan .

    ?plan
        a prov:Plan ;
        frame:gripperPosition ?gP .
    
    ?gP
        frame:ofGripper ?gripper ;
        frame:position ?position .

    ?position qudt:value ?pos_value ;
        prov:wasDerivedFrom ?reference .

    ?reference
        rdfs:comment ?reference_description .

    ?pos_value
        rdf:first ?val_x ;
        rdf:rest/rdf:first ?val_y .
}
