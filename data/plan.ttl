@base <http://purl.org/for/> .

@prefix for: <http://purl.org/for/terms#> .
@prefix press: <http://purl.org/system/press/1#> .
@prefix oven: <http://purl.org/system/oven/1#> .
@prefix frame: <http://purl.org/system/gripper-frame/1#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix workflow: <http://purl.org/for/workflow#> .
@prefix activity: <http://purl.org/for/activity#> .
@prefix pos: <http://purl.org/for/position#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix wild: <http://purl.org/wild/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


# Gripping

<plan/1#gripping>
    a prov:Plan ;
    for:initialized <workflow/instance/1#gripping> ;
    frame:gripperPosition [
        frame:position [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:PositionVector ;
            qudt:hasUnit unit:MilliM ;
            qudt:value ( 210.0 100.0 ) ;
            prov:wasDerivedFrom <http://purl.org/for/system/frame#referencePoint>
        ] ;
        frame:ofGripper <system/gripper/1#it>
    ] ;
    frame:gripperSetpoint [
        frame:setpoint [
            a qudt:Quantity ;
            qudt:hasUnit unit:UNITLESS ;
            qudt:value 60 ;
        ] ;
        frame:ofGripper <system/gripper/1#it> ;
        frame:atActivity activity:gripping
    ] ;
    frame:gripperSetpoint [
        frame:setpoint [
            a qudt:Quantity ;
            qudt:hasUnit unit:UNITLESS ;
            qudt:value 60 ;
        ] ;
        frame:ofGripper <system/gripper/1#it> ;
        frame:atActivity activity:heating
    ] ;
    frame:gripperSetpoint [
        frame:setpoint [
            a qudt:Quantity ;
            qudt:hasUnit unit:UNITLESS ;
            qudt:value 60 ;
        ] ;
        frame:ofGripper <system/gripper/1#it> ;
        frame:atActivity activity:pressing
    ] ;
