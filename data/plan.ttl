# Heating

<plan/1#heating>
    a prov:Plan ;
    for:initialized <workflow/instance/1#heating> ;
    oven:thresholdTemperature [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:AreaTemperature ;
        qudt:hasUnit unit:DEG_C ;
        qudt:value 260.0
    ] ;
    oven:stableHoldingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 5.0
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/1#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/2#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/3#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/4#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/5#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/6#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/7#it>
    ] ;
    oven:fieldTargetTemperature [
        oven:fieldTarget [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 280.0
        ] ;
        oven:atField <system/field/8#it>
    ] ;
    oven:heatingDeviceTargetTemperature [
        oven:deviceTemperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 300.0
        ] ;
        oven:atDevice <system/heater/1#it>
    ] ;
    oven:heatingDeviceTargetTemperature [
        oven:deviceTemperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:AreaTemperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 300.0
        ] ;
        oven:atDevice <system/heater/2#it>
    ] .

# Pressing

<plan/1#pressing>
    a prov:Plan ;
    for:initialized <workflow/instance/1#pressing> ;
    press:force [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Force ;
        qudt:hasUnit unit:KiloN ;
        qudt:value 1000.0
    ] ;
    press:moldCoolingTime [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Time ;
        qudt:hasUnit unit:SEC ;
        qudt:value 60.0
    ] ;
    press:remainingPath [
        a qudt:Quantity ;
        qudt:hasQuantityKind quantitykind:Distance ;
        qudt:hasUnit unit:MilliM ;
        qudt:value 0.0
    ] ;
    press:moldTemperature [
        press:temperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
        press:mold <system/press/1#upperMold>
    ] ;
    press:moldTemperature [
        press:temperature [
            a qudt:Quantity ;
            qudt:hasQuantityKind quantitykind:Temperature ;
            qudt:hasUnit unit:DEG_C ;
            qudt:value 110.0
        ] ;
        press:mold <system/press/1#lowerMold>
    ] ;
    press:closingSteps (
        [
            press:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 80.0
            ] ;
            press:remainingDistance [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 60.0
            ]
        ]
        [
            press:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 60.0
            ] ;
            press:remainingDistance [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 25.0
            ]
        ]
        [
            press:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 35.0
            ] ;
            press:remainingDistance [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 10.0
            ]
        ]
        [
            press:closingSpeed [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:LinearVelocity ;
                qudt:hasUnit unit:MilliM-PER-SEC ;
                qudt:value 10.0
            ] ;
            press:remainingDistance [
                a qudt:Quantity ;
                qudt:hasQuantityKind quantitykind:Distance ;
                qudt:hasUnit unit:MilliM ;
                qudt:value 0.0
            ]
        ]
    ) .