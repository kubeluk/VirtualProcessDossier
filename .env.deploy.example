# Copy to .env.deploy.local ON THE SERVER and replace these example values.
FUSEKI_PROXY_TARGET=http://fuseki.example.org:3030
FUSEKI_DATASET=vpd
# Loopback for a host-installed outer nginx; use a private/VPN IP for direct access.
# Never bind to 0.0.0.0 or a public interface for this deployment.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080
