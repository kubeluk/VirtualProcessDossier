    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.5.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "rdf-canonize": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "^6.3.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.8"
