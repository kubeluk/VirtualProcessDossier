{
  "name": "vpd-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode development",
    "dev:remote": "vite --mode remote",
    "build": "vue-tsc --build && vite build",
