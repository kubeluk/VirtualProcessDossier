# Copy to .env.remote.local and replace the URL and dataset.
# The base URL may include a prefix, for example https://store.example.org/fuseki.
FUSEKI_PROXY_TARGET=http://fuseki.example.org:3030
FUSEKI_DATASET=vpd
# Unauthenticated remote backend; local ADMIN_PASSWORD is never used in this mode.
FUSEKI_USERNAME=
FUSEKI_PASSWORD=
