# Copy to .env for the local Docker stack and Vite development server.
# Server-side credential, never exposed as a VITE_ variable.
ADMIN_PASSWORD=admin

# Optional LOCAL Vite overrides: put these in .env.development.local.
# FUSEKI_PROXY_TARGET=http://localhost:3030
# FUSEKI_DATASET=vpd
# FUSEKI_USERNAME=admin
# FUSEKI_PASSWORD=admin
